/* HOME BANNER */

#homebanner #homebannerCarousel .carousel-inner {
    border-radius: 0;
    padding-bottom: 2%;
}

#homebanner #homebannerCarousel .carousel-item:before {
    padding-top: 100%;
}

#homebanner #homebannerCarousel .carousel-item {
    /*background: none !important;*/
}

    #homebanner #homebannerCarousel .carousel-item .homebanner_mobile {
        display: block;
    }

#homebanner #homebannerCarousel .carousel-indicators {
    bottom: -5%;
    margin: 0;
}

    #homebanner #homebannerCarousel .carousel-indicators li {
        width: 2vw;
        height: 2vw;
        margin-right: 1vw;
        margin-left: 1vw;
        border-top: none;
        border-bottom: none;
    }

#homebanner #homebannerCarousel .carousel-indicators {
    bottom: -15%;
}

#homebanner #homebannerCarousel .carousel-item::before {
    padding-top: 33.7931%;
}

#homebanner {
    position: relative;
    z-index: 0;
}

    #homebanner #homebannerCarousel .carousel-inner {
        border-radius: 0 0 1.8vw 1.8vw;
        box-shadow: -.1vw .5vw 1vw #e0e0e0;
        overflow: hidden;
    }

    #homebanner #homebannerCarousel .carousel-item {
        position: relative;
    }

        #homebanner #homebannerCarousel .carousel-item:before {
            padding-top: 33.7931%;
            content: " ";
            display: block;
        }

    #homebanner #homebannerCarousel .carousel-indicators {
        right: 0;
        bottom: -3.8vw;
        left: 0;
        margin-right: 15%;
        margin-left: 15%;
    }

        #homebanner #homebannerCarousel .carousel-indicators li {
            width: .8vw;
            height: .8vw;
            border-radius: 50%;
            margin-right: .3vw;
            margin-left: .3vw;
            background-color: #C4C4C4;
            background-clip: padding-box;
            border-top: none;
            border-bottom: none;
            opacity: 1;
        }

            #homebanner #homebannerCarousel .carousel-indicators li.active {
                background-color: #0047AB;
            }

    #homebanner #homebannerCarousel .carousel-item .homebanner_mobile {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
    
