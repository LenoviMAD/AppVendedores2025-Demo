}




.content_c_a #checkout_car .products {
    list-style: none;
    display: block;
    position: relative;
    margin: 2vw;
    padding: 0;
}

    .content_c_a #checkout_car .products > li {
        list-style: none;
        position: relative;
        display: flex;
        min-width: 22vw;
        margin: 0 0 2vw;
        padding: 0;
    }

        .content_c_a #checkout_car .products > li .thumb {
            display: inline-block;
            width: 9%;
            position: relative;
        }

            .content_c_a #checkout_car .products > li .thumb .img {
                display: block;
                border-radius: .5vw;
            }

            .content_c_a #checkout_car .products > li .thumb .delete {
                background: url(../images/mycart_del.svg) center center / contain no-repeat;
                width: 2.5vw;
                position: absolute;
                top: -1vw;
                left: -1.2vw;
            }

        .content_c_a #checkout_car .products > li .info {
            display: inline-block;
            width: 50%;
            font-family: 'Source Sans Pro', sans-serif;
            text-align: left;
            color: #828282;
            margin: 0 5%;
        }

            .content_c_a #checkout_car .products > li .info .title {
                font-weight: 600;
                font-size: 1vw;
                display: block;
                line-height: 1.4em;
                margin-bottom: .2vw;
            }

            .content_c_a #checkout_car .products > li .info .marca {
                display: block;
                font-weight: 300;
                font-size: .8vw;
                text-transform: uppercase;
                line-height: 1em;
                margin-bottom: .2vw;
            }

            .content_c_a #checkout_car .products > li .info .precio {
                display: block;
                font-weight: 700;
                font-size: 1.3vw;
                color: #428EF8;
            }

        .content_c_a #checkout_car .products > li .product_count {
            width: 2vw;
            position: absolute;
            right: 0;
            top: 50%;
            transform: translate(0,-50%);
            background: #fff;
            border-radius: 1vw;
            box-shadow: 0 .2vw .5vw #ccc;
            text-align: center;
            font-family: 'Source Sans Pro', sans-serif;
            color: #828282;
            height: 65%;
            font-size: 1.5vw;
        }

            .content_c_a #checkout_car .products > li .product_count .add,
            .content_c_a #checkout_car .products > li .product_count .value,
            .content_c_a #checkout_car .products > li .product_count .remove {
                display: block;
                text-align: center;
                height: 20%;
            }

            .content_c_a #checkout_car .products > li .product_count .value {
                margin: 0 auto;
                color: #428EF8;
                font-weight: 700;
                font-size: 1.2vw;
                height: 30%;
                display: block;
                width: 99%;
                position: relative;
                top: .5vw;
            }

.content_c_a #checkout_car #response_checkout_cart_combos.products > li .product_count {
    height: 35%;
}

.content_c_a #checkout_car .products > li .product_count a {
    color: #828282;
    display: block;
}

.content_c_a #checkout_car .products > li .thumb .img:before,
.content_c_a #checkout_car .products > li .thumb .delete:before {
    content: " ";
    display: block;
    padding-top: 100%;
}

.content_c_a #checkout_car .totals {
    border-top: 1px solid #828282;
    list-style: none;
    display: block;
    position: relative;
    margin: 2vw 2vw 2vw;
    padding: 0;
}

    .content_c_a #checkout_car .totals li,
    .content_c_a #checkout_car .totals li {
        list-style: none;
        border-bottom: 1px dotted #828282;
        font-family: 'Source Sans Pro', sans-serif;
        font-weight: 100;
        font-size: 1vw;
        text-align: left;
        color: #828282;
        overflow: hidden;
        padding: 0.5vw 0;
    }

        .content_c_a #checkout_car .totals li .title,
        .content_c_a #checkout_car .totals li.title {
            float: left;
        }

        .content_c_a #checkout_car .totals li .value,
        .content_c_a #checkout_car .totals li.value {
            float: right;
        }

        .content_c_a #checkout_car .totals li.total,
        .content_c_a #checkout_car .totals li.total {
            font-size: 1.2vw;
            font-weight: 700;
        }

.content_c_a #checkout_car div:last-child {
    text-align: center;
}

.content_c_a #checkout_car a.checkout {
    display: inline-block;
    font-size: .8vw;
    border-radius: 1vw;
    box-shadow: 0 0.2vw 0.5vw #ccc;
    margin: 0 2vw 2vw;
    padding: .5vw 1vw .6vw;
}

.static_content {
    line-height: 23px;
}



#pagination a {
    display: inline-block;
    font-size: .8vw;
    border-radius: 1vw;
    box-shadow: 0 0.2vw 0.5vw #ccc;
    margin: 0 1em 2vw;
    padding: .5vw 1vw;
    font-family: 'Source Sans Pro', sans-serif;
    position: relative;
}

    #pagination a:link,
    #pagination a:active,
    #pagination a:visited,
    #pagination a:hover {
        text-decoration: none;
    }

    #pagination a:first-child {
        padding-left: 2em;
    }

        #pagination a:first-child:before {
            display: block;
            content: "\2190";
            width: auto;
            height: auto;
            position: absolute;
            top: 50%;
            left: .8em;
            transform: translate(0,-50%);
            font-size: .9em;
        }

    #pagination a:last-child {
        padding-right: 2em;
    }

        #pagination a:last-child:after {
            display: block;
            content: "\2192";
            width: auto;
            height: auto;
            position: absolute;
            top: 50%;
            right: .8em;
            transform: translate(0,-50%);
            font-size: .9em;
        }



/* combo_productos -*/

.combo_productos {
