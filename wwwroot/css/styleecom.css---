    /* Background pattern from Toptal Subtle Patterns */
    background-image: url("../img/sync.jpg");
    background-size: 100%;
    background-repeat: no-repeat;
    text-align: center;
    border-radius: 26px;
    background-color: #002a62;
    margin: 5px;
}
#botonIngresar {
    /* Background pattern from Toptal Subtle Patterns */
  
    border-radius: 26px;
    background-color: #002a62;
