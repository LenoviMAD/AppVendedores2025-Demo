.productos_list .pitem {
    position: relative;
    border-radius: 2vw;
    box-shadow: 0 0 .4vw #ededed;
    border: 1px solid #6aa3b4;
    margin-bottom: 2vw;
    text-align: center;
    cursor: pointer;
    min-height: 72vw;
    width: -webkit-fill-available;
}

.productos_list .pitemsub {
    position: relative;
    border-radius: 2vw;
    box-shadow: 0 0 .4vw #ededed;
    border: 1px solid #6aa3b4;
    margin-bottom: 2vw;
    text-align: center;
    cursor: pointer;
    width: -webkit-fill-available;
}
.productos_list .photo {
    width: 100%;
    margin: 0vw auto;
    background-size:cover!important;
    background-position:center!important;
}

    .productos_list .photo:before {
        padding-top: 100%;
        content: " ";
        display: block;
        border-radius: 2vw;
    }
.owl-carousel.owl-drag .owl-item {
    width: 300px !important;
}
.productos_list h3 {
    font-family: 'Source Sans Pro', sans-serif;
    font-size: 3.2vw;
    font-weight: 500;
    color: black;
    text-align: center;
    width: 90%;
    margin: 0 auto 0vw;
    min-height: 7vh;
    max-height: 44vh;
    overflow: hidden;
}

.productos_list h4 {
    font-family: 'Source Sans Pro', sans-serif;
    font-size: 2.8vw;
    font-weight: 300;
    color: #5e5d5d;
    text-align: center;
    text-transform: uppercase;
    margin: 0 auto 0vw;
}
/* .productos_list .percent{background:#333;color:#FF5733;font-size:.8vw;font-weight:300;text-align:center;border-radius:1vw;display:inline-block;margin:0 auto 1vw;padding:.25vw 1vw;} */
.productos_list .percent {
    font-family: 'Source Sans Pro', sans-serif;
    font-size: 1.2vw;
    font-weight: bold;
    color: #074DA2;
    text-align: center;
    margin: 0 auto 0vw;
}



.productos_list .price {
    font-family: 'Source Sans Pro', sans-serif;
    color: #074DA2;
    font-size: 1.2vw;
    font-weight: bold;
    text-align: center;
    margin: 0 auto 0vw;
}

.productos_list .buy {
    background: #004E99;
    color: #fff;
    font-size: .7vw;
    font-weight: 500;
    text-align: center;
    border-radius: 2vw;
    width: 70%;
    display: inline-flex;
    justify-content: center;
    text-transform: uppercase;
    margin: 0 auto 1vw;
    padding: .8vw;
}


.qtyproduct {
    overflow: hidden;
    width: 92%;
    margin: 0 auto 1em;
    font-family: 'Source Sans Pro', sans-serif;
    text-align: center;
    min-height: 4vw;
}

    .qtyproduct:before {
        display: inline-block;
        height: 100%;
        vertical-align: middle;
    }

    .qtyproduct span {
        display: inline-block;
        width: 50%;
        line-height: 1.8em;
        font-size: 1em;
        vertical-align: middle;
        color: #828282;
    }

    .qtyproduct input {
        display: inline-block;
        width: 30%;
        border-radius: 1em;
        border: 1px solid #ccc;
        text-align: center;
        padding: .5em 0 .5em .75em;
        vertical-align: middle;
    }

.qtyproductempty input {
    display: hidden;
    width: 30%;
    border-radius: 1em;
    border: 1px solid #ccc;
    text-align: center;
    padding: .5em 0 .5em .75em;
    vertical-align: middle;
}


.productos_carousel .owl-carousel .owl-nav button.owl-prev,
.productos_carousel .owl-carousel .owl-nav button.owl-next {
    position: absolute;
    top: 50%;
    transform: translate(0,-50%);
    width: 4vw;
    height: 4vw;
    text-indent: -999em;
    overflow: hidden;
    display: block;
    outline: 0 !important;
}

    .productos_carousel .owl-carousel .owl-nav button.owl-prev.disabled,
    .productos_carousel .owl-carousel .owl-nav button.owl-next.disabled {
        display: none;
    }

.productos_carousel .owl-carousel .owl-nav button.owl-prev {
    left: -1vw;
    background: url(../images/car_arrow_l.svg) center center / contain no-repeat;
}

.productos_carousel .owl-carousel .owl-nav button.owl-next {
    right: -1vw;
    background: url(../images/car_arrow_r.svg) center center / contain no-repeat;
}

#product_category_car {
    margin-top: 5vw;
    margin-bottom: 2vw;
    display: none;
}

    #product_category_car .owl-carousel.owl-loaded {
        border: .4vw solid #fff;
        box-shadow: 0 0 1vw #dbdbdb;
        border-radius: 2vw;
    }

.category_n1_owl-carousel .ci_w {
    width: 80%;
    text-align: center;
    margin: 0 auto;
}

.category_n1_owl-carousel .ci_b {
    width: 28%;
    display: inline-block;
    vertical-align: middle;
    border-left: 1px solid #DADADA;
    padding-left: 6%;
    text-align: left;
}

.category_n1_owl-carousel h3 {
    text-align: left;
    width: 85%;
    margin: 0 0 1vw;
    font-size: 1vw;
    min-height: auto;
    line-height: 1em;
}

.category_n1_owl-carousel h4 {
    text-align: left;
}

.category_n1_owl-carousel .percent {
    margin: 0 0 1vw;
}

.category_n1_owl-carousel .price {
    text-align: left;
    margin: 0 0 1vw;
}

.category_n1_owl-carousel .ci_a,
.category_n1_owl-carousel .ci_c {
    width: 28%;
    display: inline-block;
    vertical-align: middle;
}

.owl-carousel.category_n1_owl-carousel .owl-nav button.owl-prev,
.owl-carousel.category_n1_owl-carousel .owl-nav button.owl-next {
    width: 4vw;
    height: 4vw;
}

.owl-carousel.category_n1_owl-carousel .owl-nav button.owl-prev {
    left: -1vw;
}

.owl-carousel.category_n1_owl-carousel .owl-nav button.owl-next {
    right: -1vw;
}

#category_product_list .cpl_item {
    border-radius: 2vw;
    box-shadow: .2vw .2vw 1vw #eee;
    text-align: center;
    margin-bottom: 2.5vw;
}

    #category_product_list .cpl_item .thumb {
        position: relative;
    }

        #category_product_list .cpl_item .thumb span {
            display: block;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            width: 80%;
        }

    #category_product_list .cpl_item .title {
        font-family: 'Source Sans Pro', sans-serif;
        font-size: .9vw;
        font-weight: 700;
        color: #828282;
        text-align: center;
        width: 55%;
        margin: 0 auto 1vw;
        font-size: .8vw;
        background: #004E99;
        border-radius: 1.5em;
        color: #fff;
        font-weight: 300;
        padding: .4em 1em;
        text-transform: uppercase;
        display: inline-block;
    }

    #category_product_list .cpl_item span.sp1 {
        box-shadow: .2vw .2vw .4vw #eee;
        background: #0047ab;
        /*color:#828282;*/
        color: #fff;
        font-size: .7vw;
        font-weight: 300;
        text-align: center;
        border-radius: 1vw;
        display: inline-block;
        text-transform: uppercase;
        margin: 0 auto 1vw;
        padding: .5vw 1vw;
        box-shadow: none;
        background: none;
        color: #000;
        display: block;
        text-align: center;
        padding-bottom: 1.5em;
    }


        #category_product_list .cpl_item span.sp1 span.t {
            display: inline-block;
            vertical-align: middle;
        }

        #category_product_list .cpl_item span.sp1 span.a {
            display: inline-block;
            vertical-align: middle;
            background: url(../images/arrow_l_w.svg) center center / contain no-repeat;
            width: 10px;
            height: 10px;
            margin-left: 2px;
        }

    #category_product_list .cpl_item .thumb:before,
    #category_product_list .cpl_item .thumb span:before {
        content: " ";
        display: block;
        padding-top: 100%;
    }

#category_product_list.margin {
    margin-top: 7vw;
}

#sidebar {
    font-family: 'Source Sans Pro', sans-serif;
    margin-top: 2vw;
    font-size: 1vw;
    color: #333;
    max-width: 90%;
}

    #sidebar .breadcrum {
        font-size: 1.2vw;
    }

        #sidebar .breadcrum a, #sidebar .breadcrum span {
            margin-right: .2vw;
        }

            #sidebar .breadcrum a.active, #sidebar #breadcrums a.active {
                color: #FF1519;
            }

    #sidebar h3 {
        font-size: 1.4vw;
        text-align: center;
        font-weight: 700;
        border-bottom: 1px solid #0047AB;
        margin-top: 2vw;
        padding-bottom: .2em;
    }

        #sidebar h3 .products_count_mobile {
            display: none;
        }

.products_count_mobile {
    display: none !important;
}

#sidebar .sbmenu li a {
    display: block;
    position: relative;
}

#sidebar .sbmenu > li > a {
    border-bottom: 1px solid #DADADA;
    padding: 1vw 0;
}

    #sidebar .sbmenu > li > a > span {
        position: absolute;
        top: 50%;
        right: 0;
        transform: translate(0,-50%);
    }

#sidebar .sbmenu li ul > li a {
    font-size: .9vw;
    padding: .5vw 0;
}

#sidebar .sbmenu li ul {
    display: none;
}

    #sidebar .sbmenu li ul.active {
        display: block;
    }

.category_top_bar {
    margin-top: 3vw;
    margin-bottom: 3vw; /*border-bottom:1px solid #DADADA;*/
    color: #828282;
    font-family: 'Source Sans Pro', sans-serif;
    font-size: 1vw;
    overflow: hidden;
}

    .category_top_bar .col_a {
        float: left;
        width: 80%;
        border-right: 1px solid #DADADA;
        padding: .2vw 1vw .2vw 0;
        display: none;
    }

        .category_top_bar .col_a .products_count {
            float: left;
            line-height: 2em;
        }

        .category_top_bar .col_a .order {
            float: right;
        }

            .category_top_bar .col_a .order select {
                border: 0;
            }

    .category_top_bar .col_b {
        float: left;
        width: 20%;
        padding: .2vw 0 .2vw 1vw;
    }

    .category_top_bar .filter_views {
        text-align: left;
    }

        .category_top_bar .filter_views span {
            display: inline-block;
            vertical-align: middle;
            margin-right: .5vw;
        }

        .category_top_bar .filter_views a {
            display: inline-block;
            width: 15%;
            vertical-align: middle;
            margin-right: .5vw;
        }

            .category_top_bar .filter_views a:before {
                content: " ";
                display: block;
                padding-top: 100%;
            }

            .category_top_bar .filter_views a.view_grid {
                background: url(../images/view_grid.svg) center center / contain repeat;
            }

            .category_top_bar .filter_views a.view_list {
                background: url(../images/view_list.svg) center center / contain repeat;
            }

.product_detail_ctn .category_top_bar {
    margin-top: 2vw;
}

.content_c_a {
    width: 100%;
    float: left;
/*    margin-top: 61px;
*/}

.content_c_a1 {
    width: 100%;
    float: left;
      margin-top: 61px;

}

.content_c_a.hascart {
    width: 80%
}

.content_c_b {
    width: 18%;
    float: left;
    margin-left: 2%;
}

.cart_content {
    text-align: center;
    border-radius: 2vw;
    background: #F2F2F2;
    font-family: 'Source Sans Pro', sans-serif;
    overflow: hidden;
    padding: 1.5vw;
}

    .cart_content .ico {
        width: 50%;
        display: block;
        margin: 0 auto 1vw;
    }

    .cart_content.cart_empty .ico {
        background: url(../images/cart_empty.svg) center center / contain repeat;
    }

    .cart_content .ico:before {
        content: " ";
        display: block;
        padding-top: 100%;
    }

    .cart_content h3 {
        color: #828282;
        text-align: center;
        font-size: 1.2vw;
    }

#sidebar .breadcrum a,
#sidebar .breadcrum span,
.interna_col_a .interna_breadcrumbs a, .interna_col_a .interna_breadcrumbs span {
    font-size: 1vw;
}

.interna_col_a {
    padding-top: 2vw;
}

.interna_col_b {
    padding-top: 2vw;
}

.interna_col_a .interna_breadcrumbs {
    font-size: .8vw;
    margin-bottom: 2vw;
    font-family: 'Source Sans Pro', sans-serif;
    font-weight: 100;
}

    .interna_col_a .interna_breadcrumbs a,
    .interna_col_a .interna_breadcrumbs span {
        margin-right: .2vw;
    }

        .interna_col_a .interna_breadcrumbs a.active {
            color: #FF1519;
        }

.interna_col_a .product {
    margin-bottom: 0vw;

}

    .interna_col_a .product:after {
        content: " ";
        display: block;
        clear: both;
    }

    .interna_col_a .product .header_mobile {
        display: none;
    }

        .interna_col_a .product .header_mobile h2 {
            font-size: 2vw;
            font-weight: 700;
            margin: 0 0 1vw;
            color: #333333;
        }

        .interna_col_a .product .header_mobile .marca {
            font-size: .9vw;
            font-weight: 100;
            margin: 0 0 1vw;
            color: #828282;
        }

    .interna_col_a .product .thumb {
        width: 50%;
        float: left;
    }

        .interna_col_a .product .thumb .thumb_img {
            background-color: #f5f5f5;
            display: block;
        }

            .interna_col_a .product .thumb .thumb_img:before {
                content: " ";
                display: block;
                padding-top: 100%;
            }

    .interna_col_a .product .details {
        width: 50%;
        float: left;
        padding: 0 2vw;
        font-family: 'Source Sans Pro', sans-serif;
    }

        .interna_col_a .product .details h2 {
            font-size: 2vw;
            font-weight: 700;
            margin: 0 0 1vw;
            color: #333333;
        }

        .interna_col_a .product .details .marca {
            font-size: 4vw;
            font-weight: 100;
            margin: 0 0 1vw;
            color: #828282;
        }

        .interna_col_a .product .details .percent {
            background: #428EF8;
            color: #fff;
            font-size: 1.2em;
            font-weight: bold;
            text-align: center;
            padding: .25vw 2vw;
            border-radius: 1vw;
            margin: 0 auto 2vw;
            display: inline-block;
        }

        .interna_col_a .product .details .price {
            color: #dc3545;
            font-size: 3vw;
            font-weight: 500;
            margin: 1vw;
            text-align: center;
        }

        .interna_col_a .product .details .price_detail {
            color: #828282;
            font-size: 1vw;
            font-weight: 500;
            margin: 0 auto 2vw;
        }

        .interna_col_a .product .details .buttons {
        }

            .interna_col_a .product .details .buttons #add_to_car {
                background: #428EF8;
                color: #fff;
                font-size: .7vw;
                font-weight: 100;
                text-align: center;
                padding: 1vw 3vw;
                border-radius: 2vw;
                margin: 0 auto;
                display: inline-block;
                text-transform: uppercase;
                vertical-align: middle;
                margin-right: 1vw;
            }

            .interna_col_a .product .details .buttons .options {
                background: url(../images/product_details_options.svg) center center / contain no-repeat;
                width: 4vw;
                display: inline-block;
                vertical-align: middle;
            }

                .interna_col_a .product .details .buttons .options:before {
                    content: " ";
                    display: block;
                    padding-top: 100%;
                }

.interna_col_a .product_details {
    font-family: 'Source Sans Pro', sans-serif;
}

    .interna_col_a .product_details nav .nav-tabs {
        display: block;
        text-align: center;
    }

        .interna_col_a .product_details nav .nav-tabs .nav-link {
            font-size: 1vw;
            font-weight: 700;
            border: none;
            color: #828282;
            padding: 1vw;
            display: inline-block;
            position: relative;
        }

            .interna_col_a .product_details nav .nav-tabs .nav-link.active {
                color: #333333;
            }

                .interna_col_a .product_details nav .nav-tabs .nav-link.active:after {
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    height: .15vw;
                    background: #428EF8;
                    content: " ";
                    display: block;
                }

    .interna_col_a .product_details #product_details_content {
        padding: 2vw;
        color: #828282;
    }

        .interna_col_a .product_details #product_details_content h3 {
            font-size: 1vw;
            margin: 0 0 1vw;
        }

        .interna_col_a .product_details #product_details_content p {
            font-size: .9vw;
        }

.lb_panel {
    position: fixed;
    z-index: 999;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: none;
}

    .lb_panel.active {
        display: block;
    }

    .lb_panel .overlay {
        width: 100%;
        height: 100%;
        background: rgba(66,142,248,0.83);
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
    }

    .lb_panel .lb_content {
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        position: absolute;
        z-index: 1;
    }

.panel_login {
    background: #fff;
    border-radius: 2vw;
    min-width: 40vw;
    font-family: 'Source Sans Pro', sans-serif;
}

    .panel_login .pl_close {
        display: block;
        background: url(../images/login_close.svg) center center / contain no-repeat;
        width: 3vw;
        position: absolute;
        top: 0;
        right: -3vw;
    }

        .panel_login .pl_close:before {
            display: block;
            content: " ";
            padding-top: 100%;
        }

    .panel_login h2.logo {
        background: #fff;
        border-radius: 1.2vw;
        box-shadow: 0 .3vw .5vw rgba(0,0,0,0.1);
        position: absolute;
        top: -1vw;
        right: 1vw;
        padding: 1.5vw 4vw;
    }

        .panel_login h2.logo span {
            display: block;
            background: url(../images/logo.svg) center center / contain no-repeat;
            width: 7vw;
        }

            .panel_login h2.logo span:before {
                display: block;
                content: " ";
                padding-top: 16.107382550336%;
            }

    .panel_login .ico_user {
        display: block;
        background: url(../images/login_user.svg) center center / contain no-repeat;
        width: 2vw;
        position: absolute;
        top: 2vw;
        left: 1vw;
    }

        .panel_login .ico_user:before {
            display: block;
            content: " ";
            padding-top: 82.608695652174%;
        }

    .panel_login .pl_content {
        padding: 2vw 4vw;
    }

        .panel_login .pl_content h3 {
            color: #0047AB;
            font-size: 1.3vw;
            font-weight: 100;
            text-transform: uppercase;
            margin: .15vw 0 1vw;
        }

        .panel_login .pl_content .desc {
            color: #828282;
            font-size: .9vw;
            font-weight: 100;
            width: 50%;
            margin: 1vw 0 3vw;
        }

            .panel_login .pl_content .desc.desc2 {
                font-weight: 700;
            }

        .panel_login .pl_content form {
            margin-bottom: 6vw;
        }

        .panel_login .pl_content .field {
            position: relative;
            width: 50%;
            margin-bottom: 2vw;
        }

            .panel_login .pl_content .field .txt_acl {
                display: block;
                color: #0047AB;
                font-size: .8vw;
            }

            .panel_login .pl_content .field .registrate_ahora {
                position: absolute;
                bottom: 10%;
                right: -85%;
            }

                .panel_login .pl_content .field .registrate_ahora a {
                    color: #0047AB;
                    font-weight: 700;
                }

            .panel_login .pl_content .field .generar {
                position: absolute;
                bottom: 22%;
                right: -85%;
            }

            .panel_login .pl_content .field label {
                color: #828282;
                font-size: 1vw;
                font-weight: 500;
                display: block;
                margin: 0 0 .6vw;
            }

            .panel_login .pl_content .field input, .panel_login .pl_content .field select {
                background: #F2F2F2;
                border-radius: 1.5vw;
                border: 0;
                font-size: 1vw;
                color: #666;
                display: block;
                width: 95%;
                padding: .7vw 1vw;
            }

            .panel_login .pl_content .field textarea, .panel_login .pl_content .field select {
                background: #F2F2F2;
                border-radius: 1.5vw;
                border: 0;
                font-size: 1vw;
                color: #666;
                display: block;
                width: 95%;
                padding: .7vw 1vw;
            }

    .panel_login .pl_buttons {
        position: absolute;
        bottom: -1vw;
        right: 1vw;
    }

        .panel_login .pl_buttons a,
        .panel_login .pl_buttons button {
            background: #fff;
            border-radius: 1.2vw;
            box-shadow: 0 .3vw .5vw rgba(0,0,0,0.1);
            text-transform: uppercase;
            font-size: .9vw;
            border: 0;
            padding: 1.5vw 2.5vw;
        }

            .panel_login .pl_buttons a span,
            .panel_login .pl_buttons button span {
                display: inline-block;
                vertical-align: middle;
            }

                .panel_login .pl_buttons a span.ico,
                .panel_login .pl_buttons button span.ico {
                    display: inline-block;
                    width: 1vw;
                    margin-right: .5vw;
                }

            .panel_login .pl_buttons a.back {
                color: #828282;
                text-align: left;
                position: relative;
                right: -2vw;
                z-index: 0;
                padding: 1.5vw 3.5vw 1.5vw 1.5vw;
            }

                .panel_login .pl_buttons a.back span.ico {
                    background: url(../images/login_back.svg) center center / contain no-repeat;
                }

                    .panel_login .pl_buttons a.back span.ico:before {
                        padding-top: 50%;
                        display: block;
                        content: " ";
                    }

            .panel_login .pl_buttons a.enter,
            .panel_login .pl_buttons button.enter {
                z-index: 1;
                position: relative;
            }

                .panel_login .pl_buttons a.enter span,
                .panel_login .pl_buttons button.enter span {
                    color: #0047AB;
                }


/* panel_login register */

#panel_register .panel_login {
    min-width: 67vw;
}

#panel_register .panel_login {
    min-width: 67vw;
}

    #panel_register .panel_login .pl_content {
        width: 70%;
    }


    #panel_register .panel_login #map_content {
        width: 27%;
        position: absolute;
        top: 60%;
        right: 4vw;
        transform: translate(0,-50%);
        height: 59%;
        overflow: hidden;
    }

        #panel_register .panel_login #map_content #reg_shipping_address_map {
            position: relative;
            width: 100%;
            height: 72%;
            display: none;
        }

            #panel_register .panel_login #map_content #reg_shipping_address_map.visible {
                display: block;
            }

        #panel_register .panel_login #map_content.pl_content {
            padding: 0;
        }

            #panel_register .panel_login #map_content.pl_content .field {
                width: 100%;
            }


/* panel_login newsletter */


#panel_newsletter .panel_login {
    min-width: 25vw;
}

    #panel_newsletter .panel_login .pl_content {
        padding: 4vw 4vw;
    }

        #panel_newsletter .panel_login .pl_content .desc {
            width: 100%;
            margin: 1vw 0 3vw;
        }

        #panel_newsletter .panel_login .pl_content .field {
            width: 100%;
        }

#panel_newsletter.lb_panel .overlay {
    display: none;
}

#panel_newsletter.lb_panel .lb_content {
    transform: translate(0,0);
    top: auto;
    left: auto;
