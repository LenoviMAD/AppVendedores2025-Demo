@using AppVendedores2025.Services

@if (Open)
{
    <div class="mau-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="modal-update-title">

        <div class="mau-card" @onclick:stopPropagation>

            <div class="mau-card-top"></div>

            <div class="mau-card-body">

                <div class="mau-badge">
                    <span class="mau-badge-dot"></span>
                    Actualización Obligatoria
                </div>

                <div class="mau-icon-wrapper">
                    <div class="mau-ring-outer"></div>
                    <div class="mau-ring-mid"></div>
                    <div class="mau-icon-inner">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5m0-5l-2.5 2.5M12 8l2.5 2.5" />
                            <path d="M9 16h6" />
                        </svg>
                    </div>
                </div>

                <h2 id="modal-update-title" class="mau-title">Nueva versión disponible</h2>

                <div class="mau-divider"></div>

                <p class="mau-message">@Mensaje</p>

                @if (!string.IsNullOrWhiteSpace(_errorMsg))
                {
                    <div class="mau-error">
                        <strong>Error:</strong> @_errorMsg
                    </div>
                }

                <button class="mau-btn" @onclick="AbrirTiendaAsync">
                    <span class="mau-btn-content">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5m0-5l-2.5 2.5M12 8l2.5 2.5" />
                            <path d="M9 16h6" />
                        </svg>
                        Actualizar Ahora
                    </span>
                </button>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter]
    public string Mensaje { get; set; } = "Para continuar usando la aplicación, debés actualizarla.";

    [Parameter] public string LinkAndroid { get; set; } = "";
    [Parameter] public string LinkIos { get; set; } = "";

    private string? _errorMsg;

    private async Task AbrirTiendaAsync()
    {
        try
        {
            _errorMsg = null;

#if IOS || MACCATALYST
            var url = LinkIos;
#elif ANDROID
            var url = LinkAndroid;
#else
            var url = LinkAndroid;
#endif

            if (!string.IsNullOrWhiteSpace(url))
                await Launcher.Default.OpenAsync(new Uri(url));
        }
        catch (Exception ex)
        {
            _errorMsg = "No se pudo abrir la tienda. " + ex.Message;
            Console.Error.WriteLine($"[ModalActualizacion.AbrirTienda] {ex}");
            StateHasChanged();
        }
    }
}
