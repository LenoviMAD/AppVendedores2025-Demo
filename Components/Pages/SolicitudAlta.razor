@page "/SolicitudAlta"
@inject IJSRuntime JS

@inject ClienteAltaService ClienteAltaService



<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.all.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@700&display=swap" rel="stylesheet">


<div id="fondoSolicitud">
    <div id="logocamionSolicitud"></div>

<h3 style="text-align: center; color: black; font-family: 'Roboto', sans-serif; font-size: 28px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2); margin-top: 60px;">
    Alta de Usuario
</h3>
    <div class="resaltadoDiv" style="color:white !important">
    @if (!solicitudEnviada)
    {   
    

        <EditForm Model="@solicitud" OnValidSubmit="@EnviarSolicitudUno">
              <DataAnnotationsValidator /> 

        <div class="CardNuevaForm" style="color:black; width: 100%;">
                    <table style="width: 100%; color:white !important" class="styled-table">
                <thead>
                    <tr style="margin-bottom:7px">
                        <th>Formulario de Alta</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <input style="width: 100%; border-color: #404040; border-width: 2px; border-style: solid; border-radius: 10px;"
                                   placeholder="Ingrese su nombre y apellido.." @bind="@solicitud.NombreApellido" />
                                    <ValidationMessage For="@(() => solicitud.NombreApellido)" style="color:white ; background-color:red" />
                            <div style="display: block; margin-top: 3px;">
                                <input style="width: 100%; border-color: #404040; border-width: 2px; border-style: solid; border-radius: 10px;"
                                       placeholder="Ingrese su dirección..." @bind="@solicitud.Direccion" />
                                    <ValidationMessage For="@(() => solicitud.Direccion)" style="color:white ; background-color:red" />
                            </div>
                            <div style="display: block; margin-top: 3px;">
                                <input style="width: 100%; border-color: #404040; border-width: 2px; border-style: solid; border-radius: 10px;"
                                       placeholder="Ingrese el teléfono..." @bind="@solicitud.Telefono" />
                                    <ValidationMessage For="@(() => solicitud.Telefono)" style="color:white ; background-color:red" />
                            </div>
                            <div style="display: block; margin-top: 3px;">
                                <input style="width: 100%; border-color: #404040; border-width: 2px; border-style: solid; border-radius: 10px;"
                                       placeholder="Ingrese su email..." @bind="@solicitud.Email" />
                                     <ValidationMessage For="@(() => solicitud.Email)" style="color:white ; background-color:red" />
                            </div>
                        </td>
                    </tr>
                    <tr style="color: black; background-color: inherit; text-align: center;">
                        <td>
                                <button style="background-color:#003366" type="submit" class="btn btn-primary btn-sm w-80">
                                Enviar solicitud
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div>
            <a  style="background-color:#003366"
                href="/" class="boton_menu2">
                <img src="/img/girar-a-la-izquierda.png" />
            </a>
        </div>
    </EditForm>
    
    }
    else
    {
        <div class="alert alert-success">
            ¡Gracias por tu solicitud a AppVendedores2025 Demo! Nos estaremos comunicando a la brevedad.
        </div>
        <div>
            <a href="/" class="boton_menu2">
                <img src="/img/girar-a-la-izquierda.png" />
            </a>
        </div>
    }
    </div>
</div>



@code {

