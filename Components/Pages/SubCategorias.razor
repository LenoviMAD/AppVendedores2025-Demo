    private List<DateTime> ObtenerDiasDisponibles()
    {
        DateTime inicio = DateTime.Now.TimeOfDay > new TimeSpan(18, 0, 0)
            ? DateTime.Today.AddDays(2)
            : DateTime.Today.AddDays(1);

        return Enumerable.Range(0, 7)
            .Select(offset => inicio.AddDays(offset))
            .Where(dia => dia.DayOfWeek != DayOfWeek.Sunday)
            .ToList();
    }

