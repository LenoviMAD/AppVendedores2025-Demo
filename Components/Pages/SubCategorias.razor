@page "/subCategorias/"
@page "/subCategorias/{categoriaEligidaID:int}"

@inherits UtilCompartidas
@using AppVendedores2025.Services
@using AppVendedores2025.Shared
@using EntidadesAppVendedores
@using Microsoft.AspNetCore.Components.Web
@using AppVendedores2025.Components.Pages.VistaProductosComponents
@using Microsoft.JSInterop
@using Newtonsoft.Json
@using System.Diagnostics
@using MercadoPago.Resource.Preference
@using System.Text

@inject IProductoListaItem oProductoListaService
@inject IJSRuntime JS
@inject NavigationManager _navigationManager
@inject ICombosItemService oCombosItemService
@inject MercadoPagoService PagoService

@if (!_inicializado)
{
    <div id="app">
        <div class="spinner-container">
            <div>
                <span class="distri">Demo</span><span class="sur"> Ventas</span>
            </div>
            <div class="spinner"></div>
            <div class="cargando">@AppResources.Cargando</div>
        </div>
    </div>
}
else
{
    <div class="sinmargenes">

        <VistaProductosHeader
            TextoFiltro="@textoFiltro"
            CantEnCart="@cantEnCart()"
            TotalCarrito="@totalCarrito"
            ClienteItem="@cliente"
            TipoVendedor="@tipoVendedor"
            ModoTestGps="false"
            ListaDeProductosCargada="true"
            OnTextoCambiado="SettextoFiltro"
            OnAbrirCarrito="AbrirModalCarrito"
            OnOpenCategorias="openCategorias" />

        <div class="content_c_a1" style="padding-bottom: 70px;">
            <div class="mt-3 px-2 px-md-3">

                <a href="/catalogoProductos" class="btn-back-cats">
                    <i class="bi-arrow-left-circle-fill"></i>
                    <span>Categorías</span>
                </a>

                @if (_loadingSubcats)
                {
                    <div class="cat-grid">
                        <div class="row g-2 m-0">
                            @foreach (var _ in Enumerable.Range(0, 6))
                            {
                                <div class="col-6 p-1">
                                    <div class="cat-card-skeleton placeholder-glow">
                                        <div class="placeholder rounded-top" style="width:100%;aspect-ratio:1/1;display:block;"></div>
                                        <div class="p-2 d-flex justify-content-center">
                                            <div class="placeholder rounded-2" style="width:70%;height:16px;"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (lsSubCategoriasElegida is null || lsSubCategoriasElegida.Count == 0)
                {
                    <div class="text-muted small px-1">
                        <i class="bi-info-circle me-1"></i> No hay subcategorías para mostrar.
                    </div>
                }
                else
                {
                    <div class="cat-grid">
                        <div class="row g-2 m-0">
                            @foreach (var cat in lsSubCategoriasElegida)
                            {
                                <div class="col-6 p-1">
                                    <button class="cat-card"
                                            type="button"
                                            aria-label="Abrir @cat.subCategoria"
                                            @onclick="() => FiltrarProductosxSubcagtegoria(null, cat.subCategoriasEcomItemID)">
                                        <div class="cat-card-img-wrap">
                                            <img src="@cat.imagen"
                                                 class="cat-card-img"
                                                 alt="@cat.subCategoria"
                                                 loading="lazy"
                                                 onerror="this.onerror=null;this.src='/img/categorias/placeholder.png';" />
                                        </div>
                                        <div class="cat-card-info">
                                            <p class="cat-card-name">@cat.subCategoria</p>
                                        </div>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

        <ModalCarrito
            CartView="@cartview"
            CartViewCombos="@cartviewCombos"
            TotalCarrito="@totalCarrito"
            TotalCarritoFinal="@totalCarritoFinal"
            TotalCarritoNeto="@totalCarritoNeto"
            ListaPercepcionesCalculadas="@listaPercepcionesCalculadas"
            TipoVendedor="@tipoVendedor"
            ListaaUsar="@listaaUsar"
            DiasDisponibles="@diasDisponibles"
            NombreBoton="@nombreBoton"
            IsModalVisible="@isModalVisible"
            Progress="@progress"
            OnBorrarCart="(id) => BorrarCart(clienteID)"
            OnBorrarProducto="(id) => BorrarProductodelCarrito(id, JS)"
            OnBorrarCombo="(id) => BorrarCombodelCArritoxClienteID(null, id)"
            OnActualizarCantidad="(t) => ActualizarCantidadCarrito(t.Item1, t.Item2, t.Item3, listaaUsar)"
            OnActualizarDia="ActualizarDia"
            OnTransmitir="(t) => Transmitir(t.Item1, t.Item2)"
            OnAbrirProducto="AbrirModalProducto"
            OnCloseModal="CloseModal" />

        <ModalProductoDetalle
            ProdInfoModal="@prodInfoModal"
            ListaaUsar="@listaaUsar"
            CantidadProductoModal="@cantidadProductoModal"
            TipoVendedor="@tipoVendedor"
            TipoVD="@oParam.tipoVD"
            CFenCliente="@CFenClienteSub"
            Cf="@cf"
            BultoV2="@bulto"
            ClienteMCE="@cliente.cli_MCE"
            TextoVD="@textoVD"
            Combos="@GetCombosDelProducto(prodInfoModal)"
            OnCantidadChanged="ModificarCantidadProducto"
            OnCambiarLista="CambiarLista"
            OnChangeCF="(t) => ChangeCF(t.Item1, t.Item2)"
            OnChangeBulto="(t) => ChangeBulto(t.Item1, t.Item2)"
            OnAgregarCarrito="(p) => ActualizarCantidadCarrito(null, p, 0, listaaUsar)"
            OnAbrirCombo="AbrirModalProducto" />

        <div class="vp-bottom-nav">
            <a class="vp-nav-item vp-nav-heart" @onclick="@(() => LoQmasMeGusta())">
                <i class="bi-heart-fill"></i>
                <span>Me gusta</span>
            </a>
            <a class="vp-nav-item vp-nav-fire" @onclick="@(() => LoMasPedido())">
                <i class="bi-fire"></i>
                <span>Más pedido</span>
            </a>
            <a class="vp-nav-item vp-nav-catalog active">
                <i class="bi-grid-3x3-gap-fill"></i>
                <span>Catálogo</span>
            </a>
            <a class="vp-nav-item vp-nav-new" @onclick="@(() => NuevosIngresos())">
                <i class="bi-lightning-fill"></i>
                <span>Nuevos</span>
            </a>
            <a href="/" class="vp-nav-item vp-nav-user">
                <i class="bi-person-fill"></i>
                <span>Mi cuenta</span>
            </a>
        </div>

        <ModalComboDetalle
            comboidActual="@comboid"
            ComboHeadItem="@comboHeadItem"
            LsProductosCC="@lsProductosCC"
            LsProductosSC="@lsProductosSC"
            CantidadDeCombo="@cantidadDeCombo"
            MsgErrorCombo="@msgErrorCombo"
            ListaaUsar="@listaaUsar"
            TipoVendedor="@tipoVendedor"
            TipoVD="@oParam.tipoVD"
            CFenCliente="@CFenClienteSub"
            Cf="@cf"
            ClienteMCE="@cliente.cli_MCE"
            OnCantidadCombos="(t) => CantidadDeCombos(t.Item1, t.Item2)"
            OnActualizarCantidadCC="(t) => ActualizarCantidadCarritoCombos(t.Item1, t.Item2, t.Item3)"
            OnCambiarLista="CambiarLista"
            OnChangeCF="(t) => ChangeCF(t.Item1, t.Item2)"
            OnCerrarCombo="CerrarCombo" />

        @* <section>
            <div style="display:flex; justify-content:center; padding: 24px 0 8px;">
                <img src="/img/logo.gif" height="80" width="80" style="opacity:0.5;" />
            </div>
        </section> *@

    </div>
}

@code {

    [Parameter]
    public int categoriaEligidaID { get; set; }

    // ─── Estado de carga ──────────────────────────────────────────
    private bool _inicializado = false;
    private bool _loadingSubcats = false;

    // ─── Servicios / parámetros ───────────────────────────────────
    ParametrosServices oParam = new ParametrosServices();
    PedidoCabeceraService oPedidoCabeceraService = new PedidoCabeceraService();
    ProductosSubCategoriasService oProductosSubCategoriasService = new ProductosSubCategoriasService();
    CombosxclienteService oCombosxclienteService = new CombosxclienteService();

    // ─── Listas de productos ──────────────────────────────────────
    private List<ProductoListaItem> lsProductos = new List<ProductoListaItem>();
    private List<ProductoListaItem> lsProductosBack = new List<ProductoListaItem>();
    private List<ProductoListaItem> lsCombosProducto = new List<ProductoListaItem>();
    private List<ProductoListaItem> lsProductosTT = new List<ProductoListaItem>();
    private List<CombosXClientesItem> lsCombosXCliOrdenados = new List<CombosXClientesItem>();

    private ProductoListaItems lsProductosItemsTT
    {
        get
        {
            ProductoListaItems lsDatos = new ProductoListaItems();
            lsDatos.AddRange(lsProductosTT.ToList());
            return lsDatos;
        }
    }

    // ─── Carrito ──────────────────────────────────────────────────
    public List<PedidosDetalleItem> cart = new List<PedidosDetalleItem>();
    private List<ProductoListaItem> cartview = new List<ProductoListaItem>();
    private List<ProductoListaItem> cartviewCombos = new List<ProductoListaItem>();
    private decimal faltaArrastre = 0;
    private decimal totalCarritoProductos = 0;
    List<Percepciones> listaPercepcionesCalculadas = new List<Percepciones>();

    // ─── Categorías / Subcategorías ───────────────────────────────
    private List<CategoriaItem> lsCategorias = new List<CategoriaItem>();
    private List<SubCategoriasApiEcomItem> lsSubCategorias = new List<SubCategoriasApiEcomItem>();
    private List<SubCategoriasApiEcomItem> lsSubCategoriasElegida = new List<SubCategoriasApiEcomItem>();

    // ─── Marcas ───────────────────────────────────────────────────
    private List<string> lsMarcas = new List<string>();
    string MarcaSeleccionada = "";

    // ─── Modal progress bar ───────────────────────────────────────
    private bool isModalVisible = false;
    private int progress = 0;
    private bool respPagoRecibido = false;

    // ─── Combos ───────────────────────────────────────────────────
    private List<ProductoListaItem> lsProductosCC = new List<ProductoListaItem>();
    private List<ProductoListaItem> lsProductosSC = new List<ProductoListaItem>();
    CombosHeadItem comboHeadItem = new CombosHeadItem();

    // ─── Campos generales ─────────────────────────────────────────
    private ClienteItem cliente = new ClienteItem();

    public List<DateTime> diasDisponibles = new List<DateTime> { DateTime.Now.AddDays(1) };
    public DateTime? fechaSeleccionada;

    int clienteID = 0;
    int pedidoCabeceraId = 0;
    int listaaUsar = 1;
    string ListadePreciosNomre = "";
    decimal totalCarrito = 0;
    decimal totalCarritoNeto = 0;
    decimal totalCarritoNetoPercep = 0;
    decimal totalCarritoFinal = 0;

    string textoFiltro = "";
    public string textoFiltroAnterior = "";
    int OrdenSeleccionado = 0;
    bool estoyretrocediendo = false;

    ChangeEventArgs changeEventArgsDeleteCarrito = new ChangeEventArgs();
    ProductoListaItem prodInfoModal = new ProductoListaItem();

    string version;
    int comboid;
    int cantCC = 0;
    int cantSC = 0;
    int cantidadDeCombo = 1;
    bool linecombo = true;
    string msgErrorCombo = "";
    string textoVD = "";

    int Color = 0;
    string vendedor = "";
    int vendedorID;

    bool CFenClienteSub = false;
    bool bulto = false;
    bool cf = true;
    bool tipoVendedor = false;
    public string nombreBoton = "Transmitir Pedido";
    public string comentario = "";

    List<Migajas> migajas = new List<Migajas>();

    // ─── Combos del producto (para ModalProductoDetalle) ──────────
    public List<CombosEnUnProductoItem> GetCombosDelProducto(ProductoListaItem productoListaItem)
    {
        return lsProductosItemsTT.GetProductoListaCombos(productoListaItem);
    }

    // ─── Ciclo de vida ────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeAsync<string>("cargarCarousel");
            if (firstRender)
            {
                oParam.PagePadre = "subCategorias";
                if (tipoVendedor)
                    nombreBoton = "Realizar Pago";
            }
        }
        catch
        {
            await Task.Delay(3000);
            await JS.InvokeAsync<string>("cargarCarousel");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loadingSubcats = true;
        changeEventArgsDeleteCarrito.Value = 0;

        tipoVendedor = oParam.TipoDeUsuario;

        try
        {
            listaaUsar = (int)oParam.ListadePrecios;
            ListadePreciosNomre = oParam.listadePreciosNombre;
            vendedor = oParam.Vendedor;
            Color = Int32.Parse(oParam.Color);
            vendedorID = Int32.Parse(oParam.VendedorID);
            version = oParam.VersionApp;
            textoVD = oParam.TextoVD;
        }
        catch
        {
            oParam.ListadePrecios = 1;
            oParam.listadePreciosNombre = "Especial Distribucion";
        }

        diasDisponibles = ObtenerDiasDisponibles();

        await JS.InvokeAsync<string>("ocultarnav");
        clienteID = (int)oParam.ClienteID;
        pedidoCabeceraId = (int)oParam.CabeceraCarritoID;

        ClienteItemService oClienteItemService = new ClienteItemService();
        cliente = await oClienteItemService.GetByID(clienteID);

        CFenClienteSub = cliente.CUITValido == 0;

        if (cliente.cli_MCE == 0)
            cf = cliente.CUITValido == 0;

        lsProductosTT = await oProductoListaService.GetAll();

        lsCombosXCliOrdenados = await oCombosxclienteService.GetCombosxClientexCliID(clienteID);
        lsCombosXCliOrdenados = lsCombosXCliOrdenados.OrderBy(c => c.Orden).ToList();

        await oCombosItemService.GetNombreCombo(0);
        await GetCategorias();

        Traer(0);
        GenerarVistaSubCategorias(categoriaEligidaID);

        _loadingSubcats = false;
        _inicializado = true;
    }

    // ─── Categorías / subcategorías ───────────────────────────────

    private async Task<int> GetCategorias()
    {
        lsCategorias = await oProductoListaService.GetCatgorias(JS);
        lsSubCategorias = await oProductoListaService.GetSubCatgorias(JS);
        return 1;
    }

    private void GenerarVistaSubCategorias(int categoriaIDAMostrar)
    {
        lsSubCategoriasElegida.Clear();
        foreach (var sub in lsSubCategorias)
        {
            foreach (var cate in sub.categoriasID)
            {
                if (cate == categoriaIDAMostrar)
                    lsSubCategoriasElegida.Add(sub);
            }
        }
    }

    private async Task FiltrarProductosxSubcagtegoria(MouseEventArgs e, int cat)
    {
        _navigationManager.NavigateTo("/vistaProductos/" + cat);
    }

    private async Task openCategorias()
    {
        this.StateHasChanged();
    }

    // ─── Búsqueda ─────────────────────────────────────────────────

    private void SettextoFiltro(string Value)
    {
        textoFiltro = Value;
        bool esRetroceso = textoFiltro.Length < textoFiltroAnterior.Length;

        if (textoFiltro.Length > 2 && !esRetroceso)
        {
            _navigationManager.NavigateTo("/vistaProductos/0/" + textoFiltro);
            return;
        }

        textoFiltroAnterior = textoFiltro;
    }

    // ─── Carga de carrito ─────────────────────────────────────────

    public async Task Traer(int subcat)
    {
        lsProductos = lsProductosBack;
        lsCombosProducto = lsProductosTT.Where(c => c.ProductosID < 0).Take(20).ToList();

        lsProductos = await oProductoListaService.LlenarCantidadEnCarrito(clienteID,
            lsProductosTT.Where(c => c.TextoParaBusqueda.IndexOf(textoFiltro, StringComparison.InvariantCultureIgnoreCase) != -1 && c.ComboID == 0).ToList());

        lsProductosBack = lsProductos;

        lsMarcas = lsProductos
            .GroupBy(p => p.Marca)
            .Select(g => g.First().Marca)
            .ToList();

        cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
        cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
        var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
        totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
        totalCarrito = totalCarritoProductos + totalCarritoCombos;

        totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto);
        totalCarritoNeto += cartview.Sum(c => c.TotalLineaNeto);

        faltaArrastre = await oProductoListaService.EstadoArrastreParaCombos(cartview, cartviewCombos, clienteID);

        this.StateHasChanged();
    }

    // ─── Modales ──────────────────────────────────────────────────

    private async Task AbrirModalCarrito()
    {
        if (tipoVendedor)
            ActualizarValorFinalCarrito();
        else
            totalCarritoFinal = totalCarrito;

        await JS.InvokeVoidAsync("openCarritoModal");
    }

    private async Task AbrirModalProducto(int prodID)
    {
        if (prodID > 0)
        {
            prodInfoModal = lsProductosTT.Where(c => c.ProductosID == prodID).FirstOrDefault();
            this.StateHasChanged();
            await JS.InvokeVoidAsync("addtocartModal");
        }
        else
        {
            TraerCombo(-prodID);
            await JS.InvokeVoidAsync("openmodalCombo");
        }
    }

    // ─── Carrito – operaciones ────────────────────────────────────

    private async Task ActualizarCantidadCarrito(ChangeEventArgs e, ProductoListaItem proIT, int cantincrementar, int listaPrecio)
    {
        int cantenbox = 0;
        if (e != null)
            cantenbox = Convert.ToInt32(e.Value);

        proIT.ListaDePreciosUsada = (int)oParam.ListadePrecios;

        if (proIT.CantidadEnCarrito == 0 && cantincrementar == 0 && !prodInfoModal.DesactivadoParaLaVenta && cantenbox < 1)
            cantincrementar = 1;

        if (proIT.UnidadesParaCompetarUnBulto > 1 && bulto)
        {
            cantincrementar = cantincrementar * proIT.UnidadesParaCompetarUnBulto;
            decimal rr = proIT.CantidadEnCarrito / proIT.UnidadesParaCompetarUnBulto;
            proIT.CantidadEnCarrito = (int)Math.Floor(rr) * proIT.UnidadesParaCompetarUnBulto;
        }

        await ActualizarCantidadCarrito_Shared(e, proIT, cantincrementar, JS, listaPrecio, cf);
        cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
        cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
        var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
        totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
        totalCarrito = totalCarritoProductos + totalCarritoCombos;

        if (tipoVendedor)
        {
            totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto);
            totalCarritoNeto += cartview.Sum(c => c.TotalLineaNeto);
            ActualizarValorFinalCarrito();
        }
        else
        {
            totalCarritoFinal = totalCarrito;
        }

        if (cartviewCombos.Count() == 0 && cartview.Count() == 0)
        {
            totalCarritoFinal = 0;
            Traer(100002);
            await JS.InvokeVoidAsync("cerrarModal");
        }

        this.StateHasChanged();
    }

    public async Task<int> BorrarProductodelCarrito(int proID, IJSRuntime JS)
    {
        var cabecera = await oPedidoCabeceraService.GetByClienteIDsnTX(clienteID);
        PedidosDetalleItemService oPedidosDetalleItemService = new PedidosDetalleItemService();
        var lsProductoEnPedido = await oPedidosDetalleItemService.GetByPedidoCabezaraID_ProdID(cabecera.PedidoCabeceraID, proID, 0, false);
        await oPedidosDetalleItemService.Delete(lsProductoEnPedido);

        cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
        cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
        var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
        totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
        totalCarrito = totalCarritoProductos + totalCarritoCombos;

        if (tipoVendedor)
        {
            totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto);
            totalCarritoNeto += cartview.Sum(c => c.TotalLineaNeto);
            ActualizarValorFinalCarrito();
        }
        else
        {
            totalCarritoFinal = totalCarrito;
        }

        Traer(0);

        if (cartviewCombos.Count() == 0 && cartview.Count() == 0)
        {
            totalCarritoFinal = 0;
            Traer(100002);
            await JS.InvokeVoidAsync("cerrarModal");
        }

        this.StateHasChanged();
        return 0;
    }

    public async Task BorrarCart(int clienteid)
    {
        await BorrarPedidoSinTx(clienteid);
        Traer(100003);
        this.StateHasChanged();
    }

    private async Task BorrarCombodelCArritoxClienteID(MouseEventArgs r, int comboid)
    {
        await BorrarCombodelCArritoxClienteID_shared(clienteID, comboid, pedidoCabeceraId);

        cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
        cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
        var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
        totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
        totalCarrito = totalCarritoProductos + totalCarritoCombos;

        if (tipoVendedor)
        {
            totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto);
            totalCarritoNeto += cartview.Sum(c => c.TotalLineaNeto);
            ActualizarValorFinalCarrito();
        }
        else
        {
            totalCarritoFinal = totalCarrito;
        }

        if (cartviewCombos.Count() == 0 && cartview.Count() == 0)
        {
            totalCarritoFinal = 0;
            Traer(100002);
            await JS.InvokeVoidAsync("cerrarModal");
        }

        Traer(0);
        this.StateHasChanged();
    }

    public int cantEnCart()
    {
        return cartview.Count() + cartviewCombos.Count();
    }

    // ─── Transmisión de pedido ────────────────────────────────────

    bool transmitiendo = false;

    public async Task Transmitir(decimal totalCarrito, decimal totalNeto)
    {
        var head = await oPedidoCabeceraService.GetByClienteIDsnTX(clienteID);
        head.TotalPedido = totalCarrito;
        await oPedidoCabeceraService.UpdateTotalPedido(head.PedidoCabeceraID, totalCarrito);

        if (head != null)
        {
            bool confirmarTransmision = await App.Current.MainPage.DisplayAlert("Confirmación", "¿Estás seguro de que deseas transmitir el pedido?", "Sí", "No");

            if (confirmarTransmision && !transmitiendo)
            {
                transmitiendo = true;
                await JS.InvokeVoidAsync("showLoader");

                if (tipoVendedor)
                {
                    var montoMinimo = oParam.montoMinimo;
                    bool confirmarMonto = true;

                    if (head.TotalPedido < montoMinimo)
                    {
                        await App.Current.MainPage.DisplayAlert("Atención", "El minimo venta es " + montoMinimo + " $", "Aceptar");
                        confirmarMonto = false;
                    }

                    (string PagoID, string StatusPago, string Mensaje, string PaymentID) respuestaPago = ("", "", "", "");

                    if (confirmarMonto)
                    {
                        if (Parametros.ModoDemo)
                        {
                            await App.Current.MainPage.DisplayAlert("Modo demo", "Pago no disponible en modo demo", "Aceptar");
                            return;
                        }

                        string KeyPagoID = head.ClienteID + "_" + head.VendedorID + "_" + DateTime.Now.ToString("yyyyMMddHHmmss");
                        await oPedidoCabeceraService.UpdateKeyPagoID(head.PedidoCabeceraID, KeyPagoID);

                        var mercadoPago = new Preference();
                        try
                        {
                            mercadoPago = oParam.MP_Test != "1"
                                ? await PagoService.PagoPreference((double)head.TotalPedido, KeyPagoID)
                                : await PagoService.PagoPreference(1, KeyPagoID);
                        }
                        catch
                        {
                            mercadoPago = await PagoService.PagoPreference((double)head.TotalPedido, KeyPagoID);
                        }

                        await Launcher.OpenAsync(mercadoPago.InitPoint);
                        var keyID = await oPedidoCabeceraService.ObtenerKeyPagoID(head.PedidoCabeceraID);

                        isModalVisible = true;
                        progress = 0;
                        await InvokeAsync(StateHasChanged);

                        _ = Task.Run(async () =>
                        {
                            respuestaPago = await PagoService.ConsultarPagoConIntervaloAsync(keyID);
                            respPagoRecibido = true;
                            progress = 100;
                            await InvokeAsync(StateHasChanged);
                        });

                        var tiempoMaximo = TimeSpan.FromMinutes(5);
                        var inicio = DateTime.Now;
                        while (DateTime.Now - inicio < tiempoMaximo)
                        {
                            if (respPagoRecibido) break;
                            progress = (int)((DateTime.Now - inicio).TotalSeconds / tiempoMaximo.TotalSeconds * 100);
                            await InvokeAsync(StateHasChanged);
                            await Task.Delay(1000);
                        }

                        isModalVisible = false;
                        await InvokeAsync(StateHasChanged);

                        string paymentID = "";
                        if (respuestaPago.StatusPago == "approved")
                        {
                            try
                            {
                                if (respuestaPago.PaymentID != null)
                                {
                                    paymentID = respuestaPago.PaymentID;
                                    await oPedidoCabeceraService.UpdatePaymentID(head.PedidoCabeceraID, paymentID);
                                }
                            }
                            catch { }

                            var res = await oPedidoCabeceraService.TransmitirPedido(head.PedidoCabeceraID, lsProductosItemsTT, comentario, head.TotalPedido, paymentID);

                            if (res.StartsWith("Ok"))
                                await App.Current.MainPage.DisplayAlert("Atención", respuestaPago.Mensaje + " tu pedido ha ingresado correctamente", "Aceptar");
                            else
                                await App.Current.MainPage.DisplayAlert("Atención", respuestaPago.Mensaje + " Tuvimos un problema con su pedido. Por favor, comuníquese con AppVendedores2025 Demo. PaymentMP: " + paymentID + " KeyID: " + keyID, "Aceptar");
                        }
                        else
                        {
                            await App.Current.MainPage.DisplayAlert("Atención", respuestaPago.Mensaje + " No se pudieron encontrar registros de tu pago. ¡Por favor, inténtalo nuevamente!", "Aceptar");
                        }
                    }

                    await JS.InvokeVoidAsync("hideLoader");
                    transmitiendo = false;
                    respPagoRecibido = false;
                    Traer(100002);
                    await JS.InvokeVoidAsync("cerrarModal");
                }
                else
                {
                    var res = await oPedidoCabeceraService.TransmitirPedido(head.PedidoCabeceraID, lsProductosItemsTT, comentario, head.TotalPedido, "");

                    if (res.StartsWith("Ok"))
                        await App.Current.MainPage.DisplayAlert("Atención", "Tu pedido ha ingresado correctamente.", "OK");
                    else
                        await App.Current.MainPage.DisplayAlert("", res, "Aceptar");

                    await JS.InvokeVoidAsync("hideLoader");
                    transmitiendo = false;
                    Traer(100002);
                    await JS.InvokeVoidAsync("cerrarModal");
                }
            }
        }
    }

