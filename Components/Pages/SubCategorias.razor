    // ─── Percepciones / total final ───────────────────────────────

    public int ActualizarValorFinalCarrito()
    {
        if (totalCarritoNeto > 0)
        {
            var percepciones = oParam.ObtenerPercepciones();
            listaPercepcionesCalculadas.Clear();
            decimal porce = 0;

            foreach (var itemPer in percepciones)
            {
                if (totalCarritoNeto >= itemPer.Monto)
                {
                    try
                    {
                        decimal calculoPorcetaje = (totalCarritoNeto * itemPer.Porcentaje) / 100;
                        porce += calculoPorcetaje;

                        listaPercepcionesCalculadas.Add(new Percepciones
                        {
                            descripcion = itemPer.Descripcion,
                            montoCalculado = calculoPorcetaje,
                            porcentaje = itemPer.Porcentaje
                        });
                    }
                    catch { }
                }
            }

            totalCarritoNetoPercep = porce;
            totalCarritoFinal = totalCarrito + totalCarritoNetoPercep;
        }
        else
        {
            listaPercepcionesCalculadas.Clear();
            totalCarritoNetoPercep = 0;
            totalCarritoFinal = totalCarrito;
        }

        return 1;
    }

