    // ─── Combos ───────────────────────────────────────────────────

    private async Task TraerCombo(int comboid1)
    {
        comboid = comboid1;
        lsProductosCC.Clear();
        lsProductosSC.Clear();
        ProductoListaService oProductoItemService = new ProductoListaService();
        CombosItemService oCombosItemService = new CombosItemService();

        var resHeader = await oCombosItemService.GetCombosHeadItem(comboid);
        comboHeadItem = resHeader[0];
        cantidadDeCombo = 1;

        var lsProdCombo = await oCombosItemService.GetProductosByID(comboid);
        await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT.ToList());

        cantCC = comboHeadItem.CantidadDinamica != 0 ? comboHeadItem.CantidadDinamica : comboHeadItem.Cantidad;
        cantSC = comboHeadItem.CantSCargo;

        foreach (var i in lsProdCombo)
        {
            var p = await oProductoItemService.GetByIdLista(i.ComboProductoID);

            if (i.ComboTipo == 0)
            {
                p.PorcentajDescuento1 = Convert.ToDecimal(i.Descuento1);
                p.PorcentajDescuento2 = Convert.ToDecimal(i.Descuento2);
                p.NroDeGrupoCombo = i.NrGrupoDinamico;
                p.CantidadMaximaPorGrupo = i.CantidadConCargo;
                if (i.ProductoListaItem.StockEnUnidades > 1)
                    lsProductosCC.Add(p);
            }
            else
            {
                p.PrecioUnitarioFinalAlamcene = 0;
                p.PrecioUnitarioFinalAutoservicio = 0;
                p.PrecioUnitarioFinalEspecial = 0;
                p.PrecioUnitarioFinalKiosko = 0;
                p.CantidadMaximaPorGrupo = i.CantidadConCargo;
                if (i.NrGrupoDinamico == 1)
                    p.NroDeGrupoCombo = i.NrGrupoDinamico;
                if (i.ProductoListaItem.StockEnUnidades > 1)
                    lsProductosSC.Add(p);
            }
        }

        if (comboHeadItem.CantidadDinamica == 0)
        {
            foreach (var ccIt in lsProductosCC)
                ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
            foreach (var ccIt in lsProductosSC)
                ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
        }

        foreach (var ccIt in lsProductosCC)
        {
            if (lsProductosCC.Where(c => c.NroDeGrupoCombo == ccIt.NroDeGrupoCombo).Count() == 1)
            {
                ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
                ccIt.NombreDelCombo = "1";
            }
        }
        foreach (var ccIt in lsProductosSC)
        {
            if (lsProductosSC.Where(c => c.NroDeGrupoCombo == ccIt.NroDeGrupoCombo).Count() == 1)
            {
                ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
                ccIt.NombreDelCombo = "1";
            }
        }

        this.StateHasChanged();
    }

    private bool estaProcesando = false;

    private async Task CantidadDeCombos(ChangeEventArgs e, int cantincrementar)
    {
        if (estaProcesando) return;
        estaProcesando = true;
        try
        {
            int cantNueva;

            if (e != null)
            {
                cantNueva = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? 1
                    : (int)Math.Floor(Convert.ToDouble(e.Value.ToString()));
                if (cantNueva < 1) cantNueva = 1;
            }
            else
            {
                cantNueva = cantidadDeCombo + cantincrementar;
                if (cantNueva < 1) cantNueva = 1;
            }

            if (cantNueva < cantidadDeCombo)
            {
                foreach (var item in lsProductosCC) item.CantidadEnCarrito = 0;
                foreach (var item in lsProductosSC) item.CantidadEnCarrito = 0;
            }

            if (comboHeadItem.CantidadMaximaPorCliente != 0 && cantNueva > comboHeadItem.CantidadMaximaPorCliente)
                cantNueva = comboHeadItem.CantidadMaximaPorCliente;
            if (comboHeadItem.CantidadMaximaPorFactura != 0 && cantNueva > comboHeadItem.CantidadMaximaPorFactura)
                cantNueva = comboHeadItem.CantidadMaximaPorFactura;

            cantidadDeCombo = cantNueva;
            StateHasChanged();
        }
        finally
        {
            estaProcesando = false;
        }
    }

    private async Task ActualizarCantidadCarritoCombos(ChangeEventArgs e, ProductoListaItem proIT, int cantincrementar)
    {
        int cantNueva;

        if (e != null)
        {
            cantNueva = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? 0 : int.Parse(e.Value.ToString());
            if (cantNueva < 0) cantNueva = 0;
        }
        else
        {
            cantNueva = proIT.CantidadEnCarrito + cantincrementar;
            if (cantNueva < 0) cantNueva = 0;
        }

        proIT.CantidadEnCarrito = cantNueva;

        if (comboHeadItem.CantidadDinamica != 0)
        {
            var cantDinamicaGrp = comboHeadItem.GetCantidadesGrupo;
            var cantGrupoCarr = lsProductosCC.Where(c => c.NroDeGrupoCombo == proIT.NroDeGrupoCombo).Sum(c => c.CantidadEnCarrito);
            var maxGrupo = cantDinamicaGrp[proIT.NroDeGrupoCombo] * cantidadDeCombo;
            if (cantGrupoCarr > maxGrupo)
                proIT.CantidadEnCarrito += maxGrupo - cantGrupoCarr;
        }

        var cantTotalCC = lsProductosCC.Where(c => c.ConCargo).Sum(c => c.CantidadEnCarrito);
        if (cantTotalCC > cantCC * cantidadDeCombo)
            proIT.CantidadEnCarrito += cantCC * cantidadDeCombo - cantTotalCC;

        var cantTotalSC = lsProductosSC.Sum(c => c.CantidadEnCarrito);
        if (cantTotalSC > comboHeadItem.CantSCargo * cantidadDeCombo)
            proIT.CantidadEnCarrito += comboHeadItem.CantSCargo * cantidadDeCombo - cantTotalSC;

        if (comboHeadItem.CantidadDinamica == 0)
            proIT.CantidadEnCarrito = proIT.CantidadMaximaPorGrupo * cantidadDeCombo;

        faltaArrastre = await oProductoListaService.EstadoArrastreParaCombos(cartview, cartviewCombos, clienteID);
        CheckStatusCombo1();
        StateHasChanged();
    }

    private bool CheckStatusCombo1()
    {
        msgErrorCombo = "";
        bool comboOk = true;
        var cantTotalSC = lsProductosSC.Sum(c => c.CantidadEnCarrito);
        var cantTotalCC = lsProductosCC.Where(c => c.ConCargo).Sum(c => c.CantidadEnCarrito);

        if (cantTotalCC != cantCC * cantidadDeCombo && comboHeadItem.CantidadDinamica != 0)
        {
            msgErrorCombo += ((cantCC * cantidadDeCombo) - cantTotalCC) + " C/C ";
            comboOk = false;
        }
        if (cantTotalSC != comboHeadItem.CantSCargo * cantidadDeCombo)
        {
            msgErrorCombo += ((comboHeadItem.CantSCargo * cantidadDeCombo) - cantTotalSC) + " S/C";
            comboOk = false;
        }

        return comboOk;
    }

    private async Task CerrarCombo()
    {
        var statusCombo = CheckStatusCombo1();
        ClienteItemService oclienteItemService = new ClienteItemService();
        var cliDatos = await oclienteItemService.GetByID(clienteID);

        if (statusCombo)
        {
            await oPedidoCabeceraService.BorrarByClienteIdyComboIDSinTx(clienteID, comboid);

            int lsprcios = 1;

            foreach (var it in lsProductosCC)
            {
                if (it.CantidadEnCarrito > 0)
                {
                    decimal valorFinalCombo;
                    if (it.PorcentajDescuento1 > 0 || it.PorcentajDescuento2 > 0)
                    {
                        decimal precioLista = it.PrecioUnitarioFinal(listaaUsar);
                        decimal d1 = it.PorcentajDescuento1 > 0 ? precioLista - (precioLista * it.PorcentajDescuento1 / 100) : 0;
                        decimal d2 = it.PorcentajDescuento2 > 0 ? precioLista - (precioLista * it.PorcentajDescuento2 / 100) : 0;
                        valorFinalCombo = d1 + d2;
                    }
                    else
                    {
                        valorFinalCombo = it.PrecioUnitarioFinal(listaaUsar);
                    }

                    await oPedidoCabeceraService.AgregarPedidosCombo(clienteID, it.ProductosID, it.CantidadEnCarrito, listaaUsar, comboid, valorFinalCombo, it.PrecioUnitarioNeto(listaaUsar), it.NroDeGrupoCombo, cliDatos.cli_codigo, cliDatos.cli_direccion, it.Nombre, it.CodigoDeProducto, cf, it.UnidadesPorBulto, cantidadDeCombo, vendedorID, version, it.ComboCodigo);
                }
            }

            foreach (var it in lsProductosSC)
            {
                if (it.CantidadEnCarrito > 0)
                    await oPedidoCabeceraService.AgregarPedidosCombo(clienteID, it.ProductosID, it.CantidadEnCarrito, lsprcios, comboid, 0, 0, it.NroDeGrupoCombo, cliDatos.cli_codigo, cliDatos.cli_direccion, it.Nombre, it.CodigoDeProducto, cf, it.UnidadesPorBulto, cantidadDeCombo, vendedorID, version, it.ComboCodigo);
            }

            await App.Current.MainPage.DisplayAlert("Atencion", "Se guardo el combo", "OK");
            _navigationManager.NavigateTo("/vistaProductos/" + 100002, true);
        }
        else
        {
            await App.Current.MainPage.DisplayAlert("Atencion", "Debe completar el Combo", "OK");
        }
    }

    public string ClassPrecio(ProductoListaItem it, int tipo)
    {
        bool tachar = false;
        bool mostrardesc = false;

        if (it.PrecioNoCalculado != "N/Calc")
        {
            decimal p1 = 0;
            if (!string.IsNullOrEmpty(it.TextoCombo(listaaUsar)))
                decimal.TryParse(it.TextoCombo(listaaUsar), out p1);

            if (Math.Abs(p1 - it.PrecioUnitarioFinal(listaaUsar)) >= 0.30M && p1 != 0)
            {
                tachar = true;
                mostrardesc = true;
            }
        }

        if (tipo == 1)
            return tachar ? "text-decoration: line-through #f81404 4px;" : "";
        else
            return mostrardesc ? "" : "display:none;";
    }

