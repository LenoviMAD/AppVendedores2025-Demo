	private async Task ActualizarCantidadCarrito(ChangeEventArgs e, ProductoListaItem proIT, int cantincrementar, int listaPrecio)
	{
		// ParametrosServices oParam = new ParametrosServices();
		int cantenbox = 0;
		if (e != null)
		{ cantenbox = Convert.ToInt32(e.Value); }



		proIT.ListaDePreciosUsada = (int)(oParam.ListadePrecios);
		// prodInfoModal puede ser null (p.ej. agregar al carrito desde la grilla sin haber abierto
		// antes el modal de detalle, o si AbrirModalProducto no encontró el producto en lsProductosTT).
		// Usamos proIT (el producto real que se está agregando) como fallback.
		if (proIT.CantidadEnCarrito == 0 && cantincrementar == 0 && !(prodInfoModal?.DesactivadoParaLaVenta ?? proIT.DesactivadoParaLaVenta) && cantenbox < 1)
		{
			cantincrementar = 1;
		}

		if (proIT.UnidadesParaCompetarUnBulto > 1 && bultoV2)
		{
			cantincrementar = cantincrementar * proIT.UnidadesParaCompetarUnBulto;
			decimal rr = proIT.CantidadEnCarrito / proIT.UnidadesParaCompetarUnBulto;
			proIT.CantidadEnCarrito = (int)Math.Floor(rr) * proIT.UnidadesParaCompetarUnBulto;
		}

		if(cantenbox > 0 && cantincrementar == 0)
		{
			cantincrementar = cantenbox;
		}

		await ActualizarCantidadCarrito_Shared(e, proIT, cantincrementar, JS, listaPrecio, cf);
		cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
		//      totalCarrito = await oProductoListaService.TotalEnCarrito(lsProductosTT);
		faltaArrastre = await oProductoListaService.EstadoArrastreParaCombos(cartview, cartviewCombos, clienteID);

		cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
		var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
		totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
		totalCarrito = totalCarritoProductos + totalCarritoCombos;

		//Cuando es cliente calculamos los Netos segun percepciones antes de trasnmitir el pedido a MP
		@if (tipoVendedor)
		{
			totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto);
			totalCarritoNeto += cartview.Sum(c => c.TotalLineaNeto);
			ActualizarValorFinalCarrito();
		}
		else
		{
			totalCarritoFinal = totalCarrito;
		}


		if (cartviewCombos.Count() == 0 && cartview.Count() == 0)
		{
			totalCarritoFinal = 0;
			Traer(100002);
			await JS.InvokeVoidAsync("cerrarModal");

		}
		cantidadActual = 0;
		bultoV2 = false;
		this.StateHasChanged();
	}

	private async Task SincronizarYTransmitir(List<(int ProductosID, int Cantidad)> pendientes)
	{
		foreach (var (pid, qty) in pendientes)
		{
			var prod = lsProductosTT.FirstOrDefault(p => p.ProductosID == pid);
			if (prod != null)
			{
				var args = new ChangeEventArgs { Value = qty.ToString() };
				await ActualizarCantidadCarrito(args, prod, 0, listaaUsar);
			}
		}
		await Transmitir(totalCarritoFinal, totalCarritoNeto);
	}

