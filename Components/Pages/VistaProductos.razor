	private static async Task<T?> SafeCall<T>(Func<Task<T>> action, CancellationToken token)
	{
		try
		{
			token.ThrowIfCancellationRequested();
			var res = await action();
			token.ThrowIfCancellationRequested();
			return res;
		}
		catch (TaskCanceledException)
		{
			return default;
		}
		catch (OperationCanceledException)
		{
			return default;
		}
	}

	private static async Task SafeCall(Func<Task> action, CancellationToken token)
	{
		try
		{
			token.ThrowIfCancellationRequested();
			await action();
			token.ThrowIfCancellationRequested();
		}
		catch (TaskCanceledException) { }
		catch (OperationCanceledException) { }
	}

	public async Task Traer(int subcat)
	{
		try
		{
			botonActivo = "";
			ProductoListaService oProductoListaService = new ProductoListaService();

			ulitmaSubcatElegida = subcat;
			lsProductos = lsProductosBack;
			DateTime hoy = DateTime.Today;

			if ((oParam.FechaUltimaSincronizacion == DateTime.MinValue ||
					oParam.FechaUltimaSincronizacion < hoy) && oParam.Vendedor != null && oParam.Vendedor != "")
			{
				_navigationManager.NavigateTo("/");
				return;
			}

			if (subcat > 0)
			{
				OrdenSeleccionado = 0;
				if (!estoyretrocediendo)
				{
					var mig = new Migajas { Lugar = "subcat", Valor = subcat.ToString() };
					migajas.Add(mig);
					estoyretrocediendo = false;
				}
			}

			if (textoFiltro != "")
			{
				OrdenSeleccionado = 0;

				if (!estoyretrocediendo)
				{
					var mig = new Migajas { Lugar = "busqueda", Valor = textoFiltro };
					migajas.Add(mig);
					estoyretrocediendo = false;
				}

				lsProductos = await oProductoListaService.GetFiltroDelCliente(textoFiltro, clienteID, lsProductosTTDelCliente);
			}
			else
			{
				// OPTIMIZACI�N: si el filtro est� vac�o, NO uses IndexOf por item.
				// Equivalente: todos los productos con ComboID == 0
				var baseSinFiltro = lsProductosTT.Where(c => c.ComboID == 0).ToList();
				lsProductos = await oProductoListaService.LlenarCantidadEnCarrito(
					clienteID,
					baseSinFiltro
				);
			}

			// Limpieza de asociaciones (mantenemos tu l�gica tal cual)
			foreach (var item in lsProductosTT) item.ClientesIDAsociado = 0;
			foreach (var item in lsProductos)   item.ClientesIDAsociado = 0;

			lsCombosProducto = lsProductosTT.Where(c => c.ProductosID < 0).Take(50).ToList();

			// Subcategor�a concreta
			if (subcat > 0 && subcat < 100000)
			{
				botonActivo = "btn5";
				var prodenSubcat = await oProductosSubCategoriasService.GetProductosIDxSubcategoria(subcat);
				// Para evitar evaluar Any(...) n^2, materializamos IDs en set
				var idsSubcat = new HashSet<int>(prodenSubcat.Select(x => x.ProductosID));
				var lsProductosSubC = lsProductosTT.Where(c => idsSubcat.Contains(c.ProductosID));
				lsProductos = lsProductosSubC.ToList();
			}

			// combos
			if (subcat == 100001)
			{
				botonActivo = "btn4";
				mostrarSelect = false;
				if (Color > 0)
					lsProductos = lsProductosTT.Where(c => c.ProductosID < 0 && c.Color == Color).ToList();
				else
					lsProductos = lsProductosTT.Where(c => c.ProductosID < 0).ToList();
			}

			// lo que m�s me gusta
			if (subcat == 100002)
			{
				botonActivo = "btn1";
				lsProductos = await CargarSeccionesLoQmasMeGusta(clienteID, lsProductosTT, Color);
			}

			// lo m�s pedido
			if (subcat == 100003)
			{
				botonActivo = "btn2";
				lsProductos = await CargarSeccionesLoMasPedido(Color);
			}

			// nuevos ingresos
			if (subcat == 100004)
			{
				botonActivo = "btn3";
				_tituloSeccion.Clear();
				lsProductos = await oProductoListaService.GetNuevosIngresosService(JS, lsProductosTT, Color);
			}

			// carrito y lo m�s pedido
			if (subcat == 100005)
			{
				botonActivo = "btn2";
				lsProductos = await CargarSeccionesLoMasPedido(Color);
				AbrirModalCarrito();
			}

			lsProductosBack = lsProductos;

			lsMarcas = lsProductos
				.GroupBy(p => p.Marca)
				.Select(g => g.First().Marca)
				.ToList();

			// Carrito / totales (sin cambios de l�gica)
			cartview = await oProductoListaService.LlenarCantidadEnCarrito(clienteID, lsProductosTT);
			cartviewCombos = await GenerarCarritoProductoCombos(clienteID);
			var totalCarritoCombos = cartviewCombos.Sum(c => c.TotalLinea);
			totalCarritoProductos = cartview.Sum(c => c.TotalLinea);
			totalCarrito = totalCarritoProductos + totalCarritoCombos;
			totalCarritoFinal = totalCarrito;
			totalCarritoNeto = cartviewCombos.Sum(c => c.TotalLineaNeto) + cartview.Sum(c => c.TotalLineaNeto);

        faltaArrastre = await oProductoListaService.EstadoArrastreParaCombos(cartview, cartviewCombos, clienteID);

        if (subcat > 0 && subcat < 100000)
        {
            var lsOrdenado = lsProductos.OrderBy(c => c.OrdenXVista);
            lsProductos = lsOrdenado.ToList();
        }

        _displayedCount = _pageSize;
        _todasComisionesSonVerdaderas = lsProductos.All(p => p.ComisionDiferencial);
        this.StateHasChanged();
        mostrarSelect = true;
    }
    catch (Exception ex)
    {
        await JS.InvokeVoidAsync("console.error", $"Traer error: {ex.Message}");
        // Opcional: pod�s disparar un toast no bloqueante
        // await JS.InvokeVoidAsync("mostrarToast", "Ocurri� un error al cargar productos.");
    }
}

