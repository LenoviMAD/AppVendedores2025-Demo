	private async Task ActualizarCantidadCarritoCombos(ChangeEventArgs e, ProductoListaItem proIT, int cantincrementar)
	{
		try
		{

			if (proIT == null)
				return;

			int cantNueva;

			// 1) Determinar la nueva cantidad pedida
			if (e != null)
			{
				var raw = e.Value?.ToString();

				if (string.IsNullOrWhiteSpace(raw))
				{
					cantNueva = 0;
				}
				else if (!int.TryParse(raw, out cantNueva))
				{
					// Si no se puede parsear, vuelvo a la cantidad actual para no romper
					cantNueva = proIT.CantidadEnCarrito;
				}
			}
			else
			{
				cantNueva = proIT.CantidadEnCarrito + cantincrementar;
			}

			if (cantNueva < 0)
				cantNueva = 0;

			// 2) Limite por producto * cantidad de combos
			//    Ej: si CantidadMaximaPorGrupo = 2 y cantidadDeCombo = 3 => max 6 unidades de ese producto
			if (proIT.CantidadMaximaPorGrupo > 0)
			{
				// Por las dudas, si cantidadDeCombo viene 0, que al menos sea 1
				var totalCombos = Math.Max(1, cantidadDeCombo);

				var maxPorProducto = proIT.CantidadMaximaPorGrupo * totalCombos;

				if (cantNueva > maxPorProducto)
					cantNueva = maxPorProducto;
			}

			// Asignamos la cantidad YA CAPADA por el l�mite del producto
			proIT.CantidadEnCarrito = cantNueva;

			//==============================================================================
			// 3) L�gica de combos CON CARGO / SIN CARGO (igual que la tuya, pero usando
			//    la cantidad ya corregida de proIT.CantidadEnCarrito)
			//==============================================================================

			// --- CC: productos con cargo
			var cantCCenComboAbierto = lsProductosCC.Sum(c => c.CantidadEnCarrito);

			// Si el combo es din�mico (CantidadDinamica != 0)
			if (comboHeadItem.CantidadDinamica != 0)
			{
				var cantDinamicaGrp = comboHeadItem.GetCantidadesGrupo;

				var cantGrupoCarr = lsProductosCC
					.Where(c => c.NroDeGrupoCombo == proIT.NroDeGrupoCombo)
					.Sum(c => c.CantidadEnCarrito);

				var totalCombos = Math.Max(1, cantidadDeCombo);
				var maxGrupo = cantDinamicaGrp[proIT.NroDeGrupoCombo] * totalCombos;

				if (cantGrupoCarr > maxGrupo)
				{
					var sobra = maxGrupo - cantGrupoCarr; // sobra ser� negativo
					proIT.CantidadEnCarrito += sobra;     // resta lo que se pas�
					if (proIT.CantidadEnCarrito < 0)
						proIT.CantidadEnCarrito = 0;

					StateHasChanged();
				}
			}

			if (proIT.ConCargo)
			{
				// validar cant total en combo cc
				var cantTotalCC = lsProductosCC.Where(c => c.ConCargo).Sum(c => c.CantidadEnCarrito);

				var totalCombos = Math.Max(1, cantidadDeCombo);
				var maxCC = cantCC * totalCombos;

				if (cantTotalCC > maxCC)
				{
					var sobra = maxCC - cantTotalCC;   // negativo
					proIT.CantidadEnCarrito += sobra;  // ajusta para no pasarse

					if (proIT.CantidadEnCarrito < 0)
						proIT.CantidadEnCarrito = 0;

					StateHasChanged();
				}
			}

			// --- SC: productos sin cargo
			if (!proIT.ConCargo)
			{
				var cantSCenComboAbierto = lsProductosSC
					.Where(l => l.NroDeGrupoCombo != 1)
					.Sum(c => c.CantidadEnCarrito);

				var cantTotalSC = cantSCenComboAbierto;

				var totalCombos = Math.Max(1, cantidadDeCombo);
				var maxSC = comboHeadItem.CantSCargo * totalCombos;

				// L�mite total de productos sin cargo del combo
				if (cantTotalSC > maxSC)
				{
					var sobra = maxSC - cantTotalSC;   // negativo
					proIT.CantidadEnCarrito += sobra;  // ajusta para no pasarse

					if (proIT.CantidadEnCarrito < 0)
						proIT.CantidadEnCarrito = 0;

					StateHasChanged();
				}

				if (cantTotalSC < 0)
				{
					proIT.CantidadEnCarrito = 0;
				}
			}

			//==============================================================================
			// 4) Recalcular estado de arrastre / combo
			//==============================================================================

			if (cartview.Count > 0 || cartviewCombos.Count > 0)
			{
				faltaArrastre = await oProductoListaService
					.EstadoArrastreParaCombos(cartview, cartviewCombos, clienteID);
			}

			CheckStatusCombo1();
			StateHasChanged();
		}
		catch (Exception ex)
		{
			// Manejo de errores b�sico: pod�s reemplazar con tu logger o mostrar toast
			Console.WriteLine($"Error en ActualizarCantidadCarritoCombos: {ex}");

			// Ejemplo: dejar la cantidad en un estado consistente si algo se rompe
			// proIT.CantidadEnCarrito = Math.Max(0, proIT.CantidadEnCarrito);
			StateHasChanged();
		}
	}

