	private int cantidadProductoModal
	{
		// Se evalúa en cada render (está bindeado en el markup del modal, que siempre está
		// presente), así que prodInfoModal nulo no puede tirar NRE acá.
		get => (prodInfoModal?.CantidadEnCarrito ?? 0) * (prodInfoModal?.UnidadesPorBulto ?? 0);
		set
		{
			if (prodInfoModal == null) return;

			if (prodInfoModal.UnidadesPorBulto > 0)
			{
				prodInfoModal.CantidadEnCarrito = value / prodInfoModal.UnidadesPorBulto;
			}
			else
			{
				prodInfoModal.CantidadEnCarrito = 0;
			}
		}
	}
