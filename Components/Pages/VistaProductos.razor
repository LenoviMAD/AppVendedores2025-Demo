	private async Task CantidadDeCombos(ChangeEventArgs e, int cantincrementar)
	{

		// check max por punto de venta
		int cantNueva;

		if (!(e is null))
		{
			if (e.Value.ToString() == "") { cantNueva = 1; }
			else
			{
				cantNueva = Convert.ToInt32(Math.Floor(Convert.ToDouble(e.Value.ToString())));

			}

			if (cantNueva < 1) cantNueva = 1;
		}
		else
		{
			cantNueva = cantidadDeCombo + cantincrementar;
			if (cantNueva < 1) cantNueva = 1;

		}
		if (cantNueva < cantidadDeCombo)
		{
			//borrar tdodo
			foreach (var item in lsProductosCC)
			{
				item.CantidadEnCarrito = 0;
			}
			foreach (var item in lsProductosSC)
			{
				item.CantidadEnCarrito = 0;
			}
		}
		//   ignorar si esta en cero
		if (cantNueva > comboHeadItem.CantidadMaximaPorCliente && comboHeadItem.CantidadMaximaPorCliente != 0)
		{ cantNueva = comboHeadItem.CantidadMaximaPorCliente; }

		if (cantNueva > comboHeadItem.CantidadMaximaPorFactura && comboHeadItem.CantidadMaximaPorFactura != 0)
		{ cantNueva = comboHeadItem.CantidadMaximaPorFactura; }

		cantidadDeCombo = cantNueva;



		//AQUI VALIDAR PARA QUE ENTRE CUANDO NO SEA DINAMICA

		if (comboHeadItem.CantidadDinamica == 0)
		{
			foreach (var ccIt in lsProductosCC)
			{
				ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
			}
			foreach (var ccIt in lsProductosSC)
			{
				ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
			}

		}
		else
		{
			foreach (var ccIt in lsProductosSC)
			{
				if(ccIt.NroDeGrupoCombo == 1)
					ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
			}	
		}




		foreach (var ccIt in lsProductosCC)
		{
			var cantXGrupo = lsProductosCC.Where(c => c.NroDeGrupoCombo == ccIt.NroDeGrupoCombo).Count();
			if (cantXGrupo == 1)
			{
				ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
				ccIt.NombreDelCombo = "1";
			}
		}
		foreach (var ccIt in lsProductosSC)
		{
			var cantXGrupoSc = lsProductosSC.Where(c => c.NroDeGrupoCombo == ccIt.NroDeGrupoCombo).Count();
			if (cantXGrupoSc == 1 && lsProductosSC.Count() == 1)
			{
				// if(ccIt.)
				ccIt.CantidadEnCarrito = ccIt.CantidadMaximaPorGrupo * cantidadDeCombo;
				ccIt.NombreDelCombo = "1";
			}
		}







		CheckStatusCombo1();
		this.StateHasChanged();
	}

