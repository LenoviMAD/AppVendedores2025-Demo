	private string textoUsuario = "";
	private CancellationTokenSource _cts;

	// NUEVO: control de carreras entre requests
	private long _requestSeq = 0;

	// NUEVO: debounce corto para fluidez
	private const int DebounceMs = 1500;
	private const int DebounceStopMs = 1500; // 1.5s para "cuando deje de escribir"


	// NUEVO: evita colisiones en cargas pesadas de Traer
	private readonly SemaphoreSlim _fetchLock = new(1, 1);

	// NUEVO: flag de carga para tu UI (si no lo us�s, igual sirve de protecci�n)
	private bool isCargando = false;

	// NUEVO: cache simple para bajar carga (clave = subcat|query|cliente|color)
