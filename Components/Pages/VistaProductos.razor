								if (respuestaPagoRealizado.StatusPago == "approved")
								{
									progress = 100;
								}
								else
								{
									progress = 100;  // Si el tiempo se agot� o hubo otro tipo de respuesta
								}

								// Forzar la actualizaci�n de la UI una vez que se tenga la respuesta
								//StateHasChanged();
								await InvokeAsync(StateHasChanged);
							});

							// Establecer el tiempo m�ximo para esperar la respuesta
							var tiempoMaximo = TimeSpan.FromMinutes(5);
							var inicio = DateTime.Now;

