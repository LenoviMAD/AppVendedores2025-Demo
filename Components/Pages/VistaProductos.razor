	[JSInvokable]
	public async Task CargarMasProductos()
	{
		if (_cargandoMas) return;
		var total = lsProductos.Count(s => s.PrecioUnitarioFinal(listaaUsar) > 0 || s.Nombre.StartsWith("*"));
		if (_displayedCount >= total) return;

		_cargandoMas = true;
		await InvokeAsync(StateHasChanged);
		await Task.Delay(50);
		_displayedCount = Math.Min(_displayedCount + _pageSize, total);
		_cargandoMas = false;
		await InvokeAsync(StateHasChanged);
	}

