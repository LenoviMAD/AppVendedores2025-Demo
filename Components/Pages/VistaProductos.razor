	public int ActualizarValorFinalCarrito()
	{
		//var oParam = new ParametrosServices();

		if (totalCarritoNeto > 0)
		{
			var percepciones = oParam.ObtenerPercepciones();
			listaPercepcionesCalculadas.Clear();
			decimal TotalCarritoNet = totalCarritoNeto;

			decimal porce = 0;
			foreach (var itemPer in percepciones)
			{

				if (TotalCarritoNet >= itemPer.Monto)
				{
					try
					{

						decimal calculoPorcetaje = (TotalCarritoNet * itemPer.Porcentaje) / 100;
						porce = porce + calculoPorcetaje;

						// Crear el objeto din�mico
						Percepciones percepcionDinamica = new Percepciones();

						// Agregar las propiedades al objeto din�mico
						percepcionDinamica.descripcion = itemPer.Descripcion;
						percepcionDinamica.montoCalculado = calculoPorcetaje;
						percepcionDinamica.porcentaje = itemPer.Porcentaje;

						// Agregar el objeto a la lista
						listaPercepcionesCalculadas.Add(percepcionDinamica);

						calculoPorcetaje = 0;
					}
					catch { }
				}

			}


			totalCarritoNetoPercep = porce;
			totalCarritoFinal = totalCarrito + totalCarritoNetoPercep;
		}
		else
		{
			//borrar percepciones del carrito       
			listaPercepcionesCalculadas.Clear();
			totalCarritoNetoPercep = 0;
			totalCarritoFinal = totalCarrito;
		}

		return 1;
	}

