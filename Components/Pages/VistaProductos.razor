								}

								// Incrementamos el progreso cada segundo
								var progreso = (int)((DateTime.Now - inicio).TotalSeconds / tiempoMaximo.TotalSeconds * 100);
								progress = progreso;  // Actualizamos el progreso en el frontend

								//StateHasChanged();  // Forzamos la actualizaci�n de la UI
								await InvokeAsync(StateHasChanged);

