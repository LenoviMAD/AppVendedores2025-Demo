	private decimal CalcularPorcentaje(decimal precioOriginal, decimal precioConDescuento)
	{
		decimal porcentaje = 0;
		if (precioOriginal == 0)
			return 0;
			//return string.Empty;
		if (precioConDescuento > 0)
		{
			decimal descuento = precioOriginal - precioConDescuento;
			porcentaje = (descuento / precioOriginal) * 100;
			porcentaje = Math.Round(porcentaje, 2);

		}

		return porcentaje;

		//return $"{porcentaje.ToString("N0")}";

	}

