    private AppVersionDto? _versionInfo = null;
	public List<CombosEnUnProductoItem> GetCombosDelProducto(ProductoListaItem productoListaItem)
	{
		return lsProductosItemsTT.GetProductoListaCombos(productoListaItem);
	}

	private Dictionary<int, List<CombosProductosItem>> _comboPreciosLookup = new();
	private string _mejorPrecioComboModal = "";
	private Dictionary<int, string> _preciosConCargoModal = new();

	private async Task ValidarVersionAppAsync()
	{
		try
		{
			var service = new AppVersionService();
			var info = await service.GetVersionRequeridaAsync();
			if (info == null) return;

			_versionInfo = info;

			if (!int.TryParse(oParam.VersionApp, out int buildInstalado)) return;
			if (!int.TryParse(info.VersionMinima, out int buildMinimo)) return;

			if (buildInstalado < buildMinimo && info.ActualizacionObligatoria)
			{
				_modalActualizacionOpen = true;
				await InvokeAsync(StateHasChanged);
			}
		}
		catch (Exception ex)
		{
			Console.Error.WriteLine($"[VistaProductos.ValidarVersionAppAsync] {ex.Message}");
		}
	}

	// Pre-carga en inicio: para cada combo del cliente, trae sus CombosProductosItem (ya con TextoPrecioCalculado1..8)
	private async Task PreCargarPreciosCombos()
	{
		try
		{
			_comboPreciosLookup.Clear();
			CombosItemService oCombosItemServiceLocal = new CombosItemService();

			var uniqueComboIds = lsProductosTT
				.Where(p => p.LstComboCliente != null && p.LstComboCliente.Any())
				.SelectMany(p => p.LstComboCliente.Select(c => c.CombosID))
				.Distinct()
				.ToList();

			foreach (var comboId in uniqueComboIds)
			{
				try
				{
					var lsProdCombo = await oCombosItemServiceLocal.GetProductosByID(comboId);
					foreach (var cpItem in lsProdCombo)
					{
						var pid = cpItem.ComboProductoID;
						if (!_comboPreciosLookup.ContainsKey(pid))
							_comboPreciosLookup[pid] = new List<CombosProductosItem>();
						_comboPreciosLookup[pid].Add(cpItem);
					}
				}
				catch { }
			}
		}
		catch { }
	}

	// Devuelve el texto de precio combo para el listaaUsar actual desde CombosProductosItem
	private string GetTextoPrecioFromCombosItem(CombosProductosItem cpItem) => listaaUsar switch
	{
		1 => cpItem.TextoPrecioCalculado1,
		3 => cpItem.TextoPrecioCalculado3,
		5 => cpItem.TextoPrecioCalculado5,
		6 => cpItem.TextoPrecioCalculado6,
		4 => cpItem.TextoPrecioCalculado4,
		7 => cpItem.TextoPrecioCalculado7,
		_ => cpItem.TextoPrecioCalculado1
	};

	// Parsea un texto de precio combo a decimal
	private decimal ParsearTextoComboPrecio(string texto)
	{
		if (string.IsNullOrWhiteSpace(texto)) return decimal.MaxValue;
		texto = texto.Trim().Replace(".", "").Replace(",", ".");
		return decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : decimal.MaxValue;
	}

	// Obtiene el texto del precio combo más bajo para el producto dado (para mostrar en tarjeta)
	private string ObtenerTextoPrecioCombo(ProductoListaItem it)
	{
		try
		{
			if (_comboPreciosLookup.TryGetValue(it.ProductosID, out var items))
			{
				var mejor = items
					.OrderBy(cp => ParsearTextoComboPrecio(GetTextoPrecioFromCombosItem(cp)))
					.FirstOrDefault();
				if (mejor != null)
				{
					var texto = GetTextoPrecioFromCombosItem(mejor);
					if (!string.IsNullOrWhiteSpace(texto)) return texto;
				}
			}
			return it.TextoCombo(listaaUsar) ?? string.Empty;
		}
		catch { return string.Empty; }
	}

	// Replica ClassPrecio de ModalComboDetalle usando el lookup pre-cargado
	private bool TieneDescuentoCombo(ProductoListaItem it)
	{
		try
		{
			if (!HayCombos(it)) return false;

			var textoCombo = ObtenerTextoPrecioCombo(it);
			if (string.IsNullOrWhiteSpace(textoCombo)) return false;

			// Verificar que no es N/Calc sin descuento
			if (_comboPreciosLookup.TryGetValue(it.ProductosID, out var items))
			{
				var mejor = items
					.OrderBy(cp => ParsearTextoComboPrecio(GetTextoPrecioFromCombosItem(cp)))
					.FirstOrDefault();
				if (mejor?.PrecioNoCalculado == "N/Calc") return false;
			}
			else if (it.PrecioNoCalculado == "N/Calc" && it.PorcentajDescuento1 == 0)
			{
				return false;
			}

			var precioCombo = ParsearTextoComboPrecio(textoCombo);
			if (precioCombo == decimal.MaxValue || precioCombo <= 0) return false;

			var precioNormal = it.PrecioUnitarioFinal(listaaUsar);
			return Math.Abs(precioNormal - precioCombo) >= 0.30M;
		}
		catch { return false; }
	}

