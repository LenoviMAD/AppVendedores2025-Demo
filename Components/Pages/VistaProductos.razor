	/// <summary>
	/// Devuelve una lista de fechas disponibles para entrega, excluyendo domingos,
	/// aplicando reglas:
	///  - Domingo: +2 d�as h�biles (llega martes)
	///  - S�bado >= 14:00: +2 d�as h�biles (llega martes)
	///  - Cualquier d�a >= 17:00: +2 d�as h�biles
	///  - Otro caso: +1 d�a h�bil
	/// </summary>
	/// <param name="ahora">Fecha/hora base (opcional; por defecto DateTime.Now)</param>
	/// <param name="cantidadDias">Cantidad de fechas a devolver (por defecto 7)</param>
	public static List<DateTime> ObtenerDiasDisponibles(DateTime? ahora = null, int cantidadDias = 7)
	{
		var resultados = new List<DateTime>();
		try
		{
			DateTime now = ahora ?? DateTime.Now;
			DateTime hoy = now.Date;

			// Reglas de inicio
			DateTime inicio;

			bool esDomingo = now.DayOfWeek == DayOfWeek.Sunday;
			bool esSabado = now.DayOfWeek == DayOfWeek.Saturday;
			bool sabadoDespuesDe14 = esSabado && now.TimeOfDay >= new TimeSpan(14, 0, 0);
			bool despuesDe17 = now.TimeOfDay >= new TimeSpan(17, 0, 0);

			if (esDomingo || sabadoDespuesDe14 || despuesDe17)
			{
				// +2 d�as h�biles
				inicio = AddDiasHabiles(hoy, 2);
			}
			else
			{
				// +1 d�a h�bil
				inicio = AddDiasHabiles(hoy, 1);
			}

			// Generar "cantidadDias" d�as, saltando domingos
			int agregados = 0;
			DateTime cursor = inicio;
			while (agregados < cantidadDias)
			{
				if (cursor.DayOfWeek != DayOfWeek.Sunday)
				{
					resultados.Add(cursor);
					agregados++;
				}
				cursor = cursor.AddDays(1);
			}

			return resultados;
		}
		catch (Exception ex)
		{
			// Manejo de errores: log interno y retorno seguro
			Debug.WriteLine($"[ObtenerDiasDisponibles] Error: {ex}");
			return new List<DateTime>(); // Devolvemos lista vac�a ante error
		}
	}

	/// <summary>
	/// Suma N d�as h�biles (sin contar domingos). El s�bado s� cuenta, salvo que caiga la regla de inicio.
	/// </summary>
	private static DateTime AddDiasHabiles(DateTime fechaBase, int cantidad)
	{
		int sumados = 0;
		DateTime d = fechaBase;
		while (sumados < cantidad)
		{
			d = d.AddDays(1);
			if (d.DayOfWeek != DayOfWeek.Sunday)
			{
				sumados++;
			}
		}
		return d;
	}

