	private async Task<ResultadoProcesarCombo> ValidarYGrabarComboConItemsAsync(
	int comboId,
	int cantidadCombo,
	List<PedidosDetalleItem> productosSeleccionados)
	{
		var resultado = new ResultadoProcesarCombo();

		try
		{
			if (cantidadCombo <= 0)
			{
				resultado.Exito = false;
				resultado.Mensaje = "La cantidad de combos debe ser mayor a cero.";
				return resultado;
			}

			if (productosSeleccionados == null || productosSeleccionados.Count == 0)
			{
				resultado.Exito = false;
				resultado.Mensaje = "No se seleccionaron productos para el combo.";
				return resultado;
			}

			// ==== 1) Servicios ====
			var oProductoItemService = new ProductoListaService();
			var oCombosItemService = new CombosItemService();
			var oclienteItemService = new ClienteItemService();
			// oPedidoCabeceraService lo supongo inyectado (como en tu c�digo actual)

			// ==== 2) Header y definici�n del combo ====
			var resHeader = await oCombosItemService.GetCombosHeadItem(comboId);
			if (resHeader == null || resHeader.Count == 0)
			{
				resultado.Exito = false;
				resultado.Mensaje = $"No se encontr� el combo con ID {comboId}.";
				return resultado;
			}

			var comboHeadItemLocal = resHeader[0];

			var lsProdCombo = await oCombosItemService.GetProductosByID(comboId);
			if (lsProdCombo == null || lsProdCombo.Count == 0)
			{
				resultado.Exito = false;
				resultado.Mensaje = $"El combo {comboHeadItemLocal.Codigo} no tiene productos configurados.";
				return resultado;
			}

			// Diccionario para validar y obtener datos de configuraci�n por producto
			var dictConfig = lsProdCombo.ToDictionary(
				x => x.ComboProductoID,   // ID del producto en el combo
				x => x
			);

			// ==== 3) Validar que los seleccionados pertenecen al combo y no superan m�ximos ====
			var errores = new List<string>();

			foreach (var sel in productosSeleccionados)
			{
				// 3.1) �Existe en la definici�n del combo?
				if (!dictConfig.TryGetValue(sel.ProductoID, out var cfg))
				{
					errores.Add($"El producto {sel.ProductoID} no pertenece al combo {comboHeadItemLocal.Codigo}.");
					continue;
				}

				// 3.2) Validar ComboTipo (con cargo / sin cargo) si quer�s estricto
				// if (sel.ComboTipo != cfg.ComboTipo)
				// {
				// 	errores.Add($"El producto {sel.ProductoID} tiene un tipo de combo inv�lido.");
				// }

				// 3.3) M�ximo por producto (basado en CantidadConCargo * cantidadCombo)
				// Nota: esto asume que CantidadConCargo es la cantidad por combo.
				var maxPermitido = cfg.CantidadConCargo * cantidadCombo;

				if (maxPermitido > 0 && sel.Cantidad > maxPermitido)
				{
					errores.Add(
						$"Producto {sel.ProductoID}: cantidad {sel.Cantidad} supera el m�ximo permitido ({maxPermitido}) para {cantidadCombo} combos."
					);
				}

				// (Opcional) Pod�s validar por grupo sumando todas las l�neas del mismo grupo
				// y comparando contra CantidadDinamica o similar.
			}

			if (errores.Count > 0)
			{
				resultado.Exito = false;
				resultado.Mensaje = string.Join(Environment.NewLine, errores);
				return resultado;
			}

			// ==== 4) Traer datos del cliente ====
			var cliDatos = await oclienteItemService.GetByID(clienteID);
			if (cliDatos == null)
			{
				resultado.Exito = false;
				resultado.Mensaje = "No se encontr� el cliente asociado al pedido.";
				return resultado;
			}

			// ==== 5) Borrar combo anterior para ese cliente ====
			await oPedidoCabeceraService.BorrarByClienteIdyComboIDSinTx(clienteID, comboId);

			// ==== 6) Recorrer productos seleccionados y grabar ====
			foreach (var sel in productosSeleccionados)
			{
				if (sel.Cantidad <= 0)
					continue;

				if (!dictConfig.TryGetValue(sel.ProductoID, out var cfg))
					continue; // ya validamos antes, pero por las dudas

				// Traer info de producto de lista (para precios)
				var prodLista = await oProductoItemService.GetByIdLista(sel.ProductoID);
				if (prodLista == null)
					continue;

				// Armamos flags de con / sin cargo
				bool esConCargo = (cfg.ComboTipo == 0);

				decimal valorFinalCombo = 0m;
				decimal precioNeto = 0m;

				if (esConCargo)
				{
					// ==== 6.1) Producto con cargo: aplicar descuentos ====
					prodLista.PorcentajDescuento1 = Convert.ToDecimal(cfg.Descuento1);
					prodLista.PorcentajDescuento2 = Convert.ToDecimal(cfg.Descuento2);
					prodLista.NroDeGrupoCombo = cfg.NrGrupoDinamico;
					prodLista.CantidadMaximaPorGrupo = cfg.CantidadConCargo;
					prodLista.ComboCodigo = comboHeadItemLocal.Codigo;

					var precioLista = prodLista.PrecioUnitarioFinal(listaaUsar);
					var precioNetoBase = prodLista.PrecioUnitarioNeto(listaaUsar);

					// Descuento 1
					if (prodLista.PorcentajDescuento1 > 0)
					{
						var porcCalculado = (precioLista * prodLista.PorcentajDescuento1) / 100m;
						precioLista -= porcCalculado;
					}

					// Descuento 2
					if (prodLista.PorcentajDescuento2 > 0)
					{
						var porcCalculado = (precioLista * prodLista.PorcentajDescuento2) / 100m;
						precioLista -= porcCalculado;
					}

					valorFinalCombo = precioLista;
					precioNeto = precioNetoBase; // pod�s ajustar tambi�n con descuentos si corresponde
				}
				else
				{
					// ==== 6.2) Producto sin cargo ====
					prodLista.PrecioUnitarioFinalAlamcene = 0;
					prodLista.PrecioUnitarioFinalAutoservicio = 0;
					prodLista.PrecioUnitarioFinalEspecial = 0;
					prodLista.PrecioUnitarioFinalKiosko = 0;
					prodLista.NroDeGrupoCombo = cfg.NrGrupoDinamico;
					prodLista.CantidadMaximaPorGrupo = cfg.CantidadConCargo;
					prodLista.ComboCodigo = comboHeadItemLocal.Codigo;

					valorFinalCombo = 0;
					precioNeto = 0;
				}

				// ==== 6.3) Grabar l�nea del combo en el pedido ====
				await oPedidoCabeceraService.AgregarPedidosCombo(
					clienteID,
					prodLista.ProductosID,
					sel.Cantidad,                       // cantidad elegida por el usuario
					listaaUsar,
					comboId,
					valorFinalCombo,
					precioNeto,
					prodLista.NroDeGrupoCombo,
					cliDatos.cli_codigo,
					cliDatos.cli_direccion,
					prodLista.Nombre,
					prodLista.CodigoDeProducto,
					cf,
					prodLista.UnidadesPorBulto,
					cantidadCombo,
					vendedorID,
					version,
					prodLista.ComboCodigo
				);
			}

			// ==== 7) OK ====
			resultado.Exito = true;
			resultado.Mensaje = "Combo guardado correctamente con los productos seleccionados.";
			return resultado;
		}
		catch (Exception ex)
		{
			resultado.Exito = false;
			resultado.Mensaje = $"Error al procesar el combo {comboId}: {ex.Message}";
			Console.WriteLine(ex.ToString());
			return resultado;
		}
	}


	private int CalcularMaximoCombosPosibles(List<CombosProductosItem> lsProdCombo, int cantidadSolicitada)
	{
		// Supongo que CombosProductoItem tiene:
		// - ProductoListaItem.StockEnUnidades
		// - CantidadConCargo (cantidad por combo)
		// - ProductoListaItem.UnidadesPorBulto (si aplica)
		// Ajustalo a tus clases reales
		int maxPorTodos = int.MaxValue;

		foreach (var i in lsProdCombo.Where(x => x.ComboTipo == 0)) // con cargo
		{
			var unidadesNecesariasPorCombo = i.CantidadConCargo * (i.ProductoListaItem.UnidadesPorBulto > 0
				? i.ProductoListaItem.UnidadesPorBulto
				: 1);

			if (unidadesNecesariasPorCombo <= 0)
				continue;

			var combosPosiblesProducto = (int)(i.ProductoListaItem.StockEnUnidades / unidadesNecesariasPorCombo);

			if (combosPosiblesProducto < maxPorTodos)
				maxPorTodos = combosPosiblesProducto;
		}

		if (maxPorTodos == int.MaxValue)
			maxPorTodos = 0;

		return maxPorTodos;
	}



