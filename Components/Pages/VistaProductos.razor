	private List<ProductoListaItem> lsProductosBack = new List<ProductoListaItem>();
	private List<ProductoListaItem> lsCombosProducto = new List<ProductoListaItem>();
	private Dictionary<int, string> _tituloSeccion = new();

	private bool EsVisible(ProductoListaItem p) =>
		p.PrecioUnitarioFinal(listaaUsar) > 0 || p.Nombre.StartsWith("*");

	private void MarcarLimiteSeccion(List<ProductoListaItem> seccion, string titulo)
	{
		var primero = seccion.FirstOrDefault(EsVisible);
		if (primero != null) _tituloSeccion[primero.ProductosID] = titulo;
	}

	private async Task<List<ProductoListaItem>> CargarSeccionesLoQmasMeGusta(int cliID, List<ProductoListaItem> todos, int color)
	{
		_tituloSeccion.Clear();
		var lsFavoritos = await GetLoQmasMeGusta(cliID, todos, color);
		var lsMasPedido = await oProductoListaService.GetLoMasPedidoService(JS, lsProductosItemsTT, color);
		var idsFavoritos = new HashSet<int>(lsFavoritos.Select(p => p.ProductosID));
		var lsMasPedidoNuevos = lsMasPedido.Where(p => !idsFavoritos.Contains(p.ProductosID)).ToList();
		var idsDestacados = new HashSet<int>(idsFavoritos.Concat(lsMasPedidoNuevos.Select(p => p.ProductosID)));
		var lsResto = todos.Where(p => !idsDestacados.Contains(p.ProductosID) && (color == 0 || p.Color == color || p.Color == 0)).ToList();
		var merged = new List<ProductoListaItem>(lsFavoritos.Count + lsMasPedidoNuevos.Count + lsResto.Count);
		merged.AddRange(lsFavoritos);
		if (lsMasPedidoNuevos.Any()) { MarcarLimiteSeccion(lsMasPedidoNuevos, "Lo más pedido"); merged.AddRange(lsMasPedidoNuevos); }
		if (lsResto.Any()) { MarcarLimiteSeccion(lsResto, "Otros productos"); merged.AddRange(lsResto); }
		return merged;
	}

	private async Task<List<ProductoListaItem>> CargarSeccionesLoMasPedido(int color)
	{
		_tituloSeccion.Clear();
		var lsMasPedido = await oProductoListaService.GetLoMasPedidoService(JS, lsProductosItemsTT, color);
		var idsMasPedido = new HashSet<int>(lsMasPedido.Select(p => p.ProductosID));
		var lsResto = lsProductosTT.Where(p => !idsMasPedido.Contains(p.ProductosID) && (color == 0 || p.Color == color || p.Color == 0)).ToList();
		var merged = new List<ProductoListaItem>(lsMasPedido.Count + lsResto.Count);
		merged.AddRange(lsMasPedido);
		if (lsResto.Any()) { MarcarLimiteSeccion(lsResto, "Otros productos"); merged.AddRange(lsResto); }
		return merged;
	}

	// Variable para almacenar el valor actual
