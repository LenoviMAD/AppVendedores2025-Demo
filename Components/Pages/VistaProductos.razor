	public async Task SettextoFiltro(string value)
	{
		try
		{
			textoUsuario = value ?? string.Empty;
			bool esRetroceso = textoUsuario.Length < (textoFiltroAnterior?.Length ?? 0);

			if (textoUsuario.Length > 0)
			{
				await JS.InvokeVoidAsync("OcultarLupa");
			}

			_cts?.Cancel();
			_cts?.Dispose();
			_cts = new CancellationTokenSource();
			var token = _cts.Token;

			// Disparamos b�squeda s�lo si: 0 chars (home/lo que me gusta) o 3+ chars (filtro)
			if (textoUsuario.Length >= 3 || textoUsuario.Length == 0)
			{
				var mySeq = System.Threading.Interlocked.Increment(ref _requestSeq);

				await Task.Delay(DebounceMs, token);
				if (token.IsCancellationRequested) return;
				if (mySeq != _requestSeq) return;

				vista = "cata";

				// No borramos el input: aplicamos el filtro reci�n ac�
				textoFiltro = textoUsuario;

				// Elegimos subcat seg�n tu regla: vac�o => 100002 (lo que m�s me gusta), si no => 0
				var subcat = (textoUsuario.Length == 0) ? 100002 : 0;

				// Mantengo tu condici�n de retroceso: no hace falta ac�, ya que estamos aplicando filtro solo con 0 o 3+
				await Traer(subcat);
			}

			textoFiltroAnterior = textoUsuario;
		}
		catch (TaskCanceledException)
		{
			// Cancelaci�n por debounce: no hacer nada.
		}
		catch (OperationCanceledException)
		{
			// Tambi�n cancelaci�n: no hacer nada.
		}
		catch (Exception ex)
		{
			// Manejo de errores
			await JS.InvokeVoidAsync("console.error", $"SettextoFiltro error: {ex}");
			// opcional: toast no bloqueante
			// await JS.InvokeVoidAsync("mostrarToast", "Error al filtrar, intent� nuevamente.");
		}
	}




