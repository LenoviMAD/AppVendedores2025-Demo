	public enum OrdenSeleccionadoParaFiltrar
	{
		MayorVenta,
		SinUso,
		MenorPrecio,
		MayorPrecio,
		Nombre,
		IngresosReciente,
		UltimasUnidades,
		CombosOferta,
		NuevasIncorPoraciones,
		ProductosDestacados,
		PreciosModicados

	}



	private void SeleccionarOrden(ChangeEventArgs e)
	{
		OrdenSeleccionado = Convert.ToInt32(e.Value);
		bool estoyEnCatalogo = btoEnElQueEstoy == BotonEnLaQueEstoy.Catalogo;

		// lsProductosBack es la fuente de verdad del view actual, seteada por Traer().
		// Nunca se sobreescribe aquí para que todos los filtros partan de la misma base.
		var base_ = lsProductosBack ?? lsProductos;

		OrdenSeleccionadoParaFiltrar ordenSel = (OrdenSeleccionadoParaFiltrar)OrdenSeleccionado;
		switch (ordenSel)
		{
			case 0:
				lsProductos = base_.OrderByDescending(p => p.TotalVenta).ToList();
				LoQmasMeGusta();
				botonActivo = "btn1";
				break;

			case OrdenSeleccionadoParaFiltrar.MenorPrecio:
				lsProductos = base_.OrderBy(p => p.PrecioUnitarioFinalAutoservicio).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.MayorPrecio:
				lsProductos = base_.OrderByDescending(p => p.PrecioUnitarioFinalAutoservicio).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.Nombre:
				lsProductos = base_.OrderBy(p => p.Nombre).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.IngresosReciente:
				lsProductos = base_.Where(p => p.IngresosRecientes && p.ProductosID > 0).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.UltimasUnidades:
				lsProductos = base_.Where(p => p.StockEnUnidades > 0 && p.DiasDeStockDisponible < 4 && p.ProductosID > 0).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.CombosOferta:
				// Los combos tienen ID negativo y solo viven en lsProductosTT, no en la base del view.
				lsProductos = lsProductosTT.Where(c => c.ProductosID < 0).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.NuevasIncorPoraciones:
				lsProductos = base_.Where(p => p.NuevaIncorporacoin && p.ProductosID > 0).ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.ProductosDestacados:
				lsProductos = lsProdDif.ToList();
				break;

			case OrdenSeleccionadoParaFiltrar.PreciosModicados:
				lsProductos = base_.Where(p => p.DiasDePrecioModificado < 8 && p.ProductosID > 0).ToList();
				break;

			default:
				break;
		}

		if (!estoyEnCatalogo)
		{
			lsProductos = lsProductos.Where(p => (p.Color == Color || Color == 0)).ToList();
		}

		_displayedCount = _pageSize;
		_todasComisionesSonVerdaderas = lsProductos.All(p => p.ComisionDiferencial);
		this.StateHasChanged();
	}




