@using Microsoft.AspNetCore.Components.Routing
@using AppVendedores2025.Localization

<I18nBootstrapper />  @* si lo estás usando para i18n en index.html *@

<Router AppAssembly="@typeof(MauiProgram).Assembly" PreferExactMatches="@true">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(AppVendedores2025.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(AppVendedores2025.Components.Layout.MainLayout)">
            <p data-i18n="NotFound">Página no encontrada</p>
        </LayoutView>
    </NotFound>
</Router>
