	<ItemGroup>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings\AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- Fuerza el generador de clase tipada para AppResources -->
	<ItemGroup>
		<!-- Base: genera clase -->
		<EmbeddedResource Update="Resources\Strings\AppResources.zh-CN.resx">
			<SubType>Designer</SubType>
			<Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings\AppResources.pt-BR.resx">
			<SubType>Designer</SubType>
			<Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>

		<!-- Satélites: NO generan clase -->
		<EmbeddedResource Update="Resources\Strings\AppResources.es.resx">
			<Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings\AppResources.en.resx">
			<Generator></Generator>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<MauiImage Include="wwwroot\img\flags\en.png" />
		<MauiImage Include="wwwroot\img\flags\es.png" />
		<MauiImage Include="wwwroot\img\flags\ptbr.png" />
		<MauiImage Include="wwwroot\img\flags\zhcn.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="wwwroot\img\flags\en.png" />
		<None Include="wwwroot\img\flags\es.png" />
		<None Include="wwwroot\img\flags\ptbr.png" />
		<None Include="wwwroot\img\flags\zhcn.png" />
	</ItemGroup>


